<section class="afcs-shell {{#if openStations}}show-stations{{/if}} {{#if openWeapons}}show-weapons{{/if}} {{#if openLog}}show-log{{/if}}">
  {{#if offline}}
    <div class="afcs-offline">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <div>
        <strong>Combat Strip Offline</strong>
        <span>{{offlineReason}}</span>
      </div>
    </div>
  {{else}}
    <section class="afcs-drawer afcs-drawer-stations {{#if openStations}}is-open{{/if}}">
      <header>
        <div><span>STATIONS</span><strong>{{currentStationLabel}} — {{shipName}}</strong></div>
        <button type="button" data-toggle-panel="stations"><i class="fa-solid fa-xmark"></i></button>
      </header>
      <nav class="afcs-station-tabs" aria-label="Arkflight combat stations">
        {{#each stationRows}}
          <button type="button" data-station="{{id}}" class="{{#if active}}is-active{{/if}}">
            <i class="{{icon}}"></i><span>{{label}}</span><small>{{crew}}</small>
          </button>
        {{/each}}
      </nav>
      <div class="afcs-action-list">
        {{#each actions}}
          <article class="afcs-action-row {{#if reaction}}is-reaction{{/if}}" data-action-card title="{{description}}">
            <div class="afcs-action-text"><strong>{{name}}</strong><span>{{summary}}</span></div>
            <div class="afcs-action-meta">
              <em>{{cost}}</em>
              {{#if hasChoices}}<select data-action-choice aria-label="{{name}} choice">{{#each choices}}<option value="{{value}}">{{label}}</option>{{/each}}</select>{{/if}}
              <button type="button" data-station-action="{{id}}" {{#unless usable}}disabled{{/unless}}>{{buttonLabel}}</button>
            </div>
          </article>
        {{/each}}
      </div>
    </section>

    <section class="afcs-drawer afcs-drawer-weapons {{#if openWeapons}}is-open{{/if}}">
      <header>
        <div><span>WEAPONS</span><strong>{{shipName}} vs {{targetName}}</strong></div>
        <button type="button" data-toggle-panel="weapons"><i class="fa-solid fa-xmark"></i></button>
      </header>
      <div class="afcs-weapon-toolbar">
        <select data-target-select {{#unless hasTargets}}disabled{{/unless}} aria-label="Target ship">
          {{#if hasTargets}}{{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}{{else}}<option value="">No enemy ships</option>{{/if}}
        </select>
        <button type="button" data-use-canvas-target {{#unless hasTargets}}disabled{{/unless}} title="Use canvas target"><i class="fa-solid fa-crosshairs"></i></button>
        <button type="button" data-lock-target {{#unless target}}disabled{{/unless}} title="Target on canvas"><i class="fa-solid fa-bullseye"></i></button>
        <button type="button" class="{{#if arcVisible}}is-active{{/if}}" data-toggle-all-arcs><i class="fa-solid fa-wave-square"></i> {{arcButtonLabel}}</button>
      </div>
      {{#if target}}
      <div class="afcs-target-summary {{#if target.legal}}is-legal{{else}}is-illegal{{/if}}">
        <img src="{{target.img}}" alt="{{target.name}}">
        <div><strong>{{target.name}}</strong><span>AC {{target.armorClass}} · Hardness {{target.hardness}} · Hull {{target.hullValue}}/{{target.hullMax}}</span><small>{{target.solutionText}}</small></div>
      </div>
      {{/if}}
      <div class="afcs-weapon-groups">
        {{#if hasWeapons}}
          {{#each weaponGroups}}
            <section class="afcs-weapon-group {{colorClass}}"><h4>{{label}}</h4>
              {{#each weapons}}
                <article class="afcs-weapon-row {{#unless ready}}is-reloading{{/unless}} {{#unless legal}}is-illegal{{/unless}}">
                  <div class="afcs-weapon-text"><strong>{{name}}</strong><span>{{mountLabel}} {{mountIndex}} · {{damage}} · {{fireAP}} AP</span><small>{{solution}}</small></div>
                  <div class="afcs-weapon-meta"><em>{{statusLabel}}</em>{{#if ready}}<button type="button" data-fire-weapon="{{key}}" {{#unless legal}}disabled{{/unless}}>Fire</button>{{else}}<button type="button" data-work-weapon="{{key}}">Work Guns</button>{{/if}}</div>
                </article>
              {{/each}}
            </section>
          {{/each}}
        {{else}}<div class="afcs-empty-state">No installed weapons are available.</div>{{/if}}
      </div>
    </section>

    <section class="afcs-drawer afcs-drawer-log {{#if openLog}}is-open{{/if}}">
      <header><div><span>COMBAT LOG</span><strong>{{shipName}}</strong></div><button type="button" data-toggle-panel="log"><i class="fa-solid fa-xmark"></i></button></header>
      <div class="afcs-log-list">
        {{#if logEntries.length}}{{#each logEntries}}<article class="afcs-log-entry {{tone}}"><i class="{{icon}}"></i><div><strong>{{title}}</strong><span>{{detail}}</span></div></article>{{/each}}{{else}}<div class="afcs-empty-state">No ship-combat entries yet.</div>{{/if}}
      </div>
    </section>

    <footer class="afcs-strip {{#if activeTurn}}is-active-turn{{/if}}">
      <div class="afcs-ship">{{#if shipImg}}<img src="{{shipImg}}" alt="{{shipName}}">{{/if}}<div><strong>{{shipName}}</strong><span>{{#if activeTurn}}Active Turn{{else}}Standby{{/if}}</span></div></div>
      <div class="afcs-stat"><label>Round</label><strong>{{resources.round}}</strong></div>
      <div class="afcs-stat is-pips"><label>AP {{resources.ap}} / {{resources.apMax}}</label><div class="afcs-pips is-ap">{{#each resources.apPips}}<i class="{{#if filled}}is-filled{{/if}}"></i>{{/each}}</div><small>Spent {{resources.apSpent}}</small></div>
      <div class="afcs-stat is-pips"><label>RP {{resources.rp}} / {{resources.rpMax}}</label><div class="afcs-pips is-rp">{{#each resources.rpPips}}<i class="{{#if filled}}is-filled{{/if}}"></i>{{/each}}</div><small>Spent {{resources.rpSpent}}</small></div>
      <div class="afcs-stat is-pips is-strain"><label>Strain {{resources.strain}} / {{resources.strainMax}}</label><div class="afcs-pips is-strain">{{#each resources.strainPips}}<i class="{{#if filled}}is-filled{{/if}}"></i>{{/each}}</div></div>
      <div class="afcs-stat"><label>Heading</label><strong>{{resources.heading}}°</strong></div>
      <div class="afcs-stat is-target"><label>Target</label><strong>{{targetName}}</strong></div>
      <div class="afcs-controls">
        <button type="button" class="{{#if openStations}}is-active{{/if}}" data-toggle-panel="stations"><i class="fa-solid fa-users"></i> Stations</button>
        <button type="button" class="{{#if openWeapons}}is-active{{/if}}" data-toggle-panel="weapons"><i class="fa-solid fa-sword"></i> Weapons</button>
        <button type="button" class="{{#if arcVisible}}is-active{{/if}}" data-toggle-all-arcs><i class="fa-solid fa-wave-square"></i> {{arcButtonLabel}}</button>
        <button type="button" class="{{#if openLog}}is-active{{/if}}" data-toggle-panel="log"><i class="fa-solid fa-scroll"></i> Log</button>
        <button type="button" class="is-end" data-end-turn {{#unless gm}}disabled{{/unless}}><i class="fa-solid fa-forward-step"></i> End Turn</button>
      </div>
    </footer>
  {{/if}}
</section>
