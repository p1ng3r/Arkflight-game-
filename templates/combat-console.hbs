<section class="afcs-shell {{#if openStations}}show-stations{{/if}} {{#if openWeapons}}show-weapons{{/if}} {{#if openLog}}show-log{{/if}}">
  {{#if offline}}
    <div class="afcs-offline">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <div>
        <strong>Combat HUD Offline</strong>
        <span>{{offlineReason}}</span>
      </div>
    </div>
  {{else}}
    <section class="afcs-drawer afcs-drawer-stations {{#if openStations}}is-open{{/if}}">
      <header>
        <div><span>STATIONS</span><strong>{{currentStationLabel}} — {{shipName}}</strong></div>
        <button type="button" data-toggle-panel="stations"><i class="fa-solid fa-xmark"></i></button>
      </header>
      <nav class="afcs-station-tabs" aria-label="Arkflight combat stations">
        {{#each stationRows}}
          <button type="button" data-station="{{id}}" class="{{#if active}}is-active{{/if}}">
            <i class="{{icon}}"></i><span>{{label}}</span><small>{{crew}}</small>
          </button>
        {{/each}}
      </nav>
      <div class="afcs-action-list">
        {{#each actions}}
          <article class="afcs-action-row {{#if reaction}}is-reaction{{/if}}" data-action-card title="{{description}}">
            <div class="afcs-action-text"><strong>{{name}}</strong><span>{{summary}}</span></div>
            <div class="afcs-action-meta">
              <em>{{cost}}</em>
              {{#if hasChoices}}<select data-action-choice aria-label="{{name}} choice">{{#each choices}}<option value="{{value}}">{{label}}</option>{{/each}}</select>{{/if}}
              <button type="button" data-station-action="{{id}}" {{#unless usable}}disabled{{/unless}}>{{buttonLabel}}</button>
            </div>
          </article>
        {{/each}}
      </div>
    </section>

    <section class="afcs-drawer afcs-drawer-weapons {{#if openWeapons}}is-open{{/if}}">
      <header>
        <div><span>WEAPONS</span><strong>{{shipName}} vs {{targetName}}</strong></div>
        <button type="button" data-toggle-panel="weapons"><i class="fa-solid fa-xmark"></i></button>
      </header>
      <div class="afcs-weapon-toolbar">
        <select data-target-select {{#unless hasTargets}}disabled{{/unless}} aria-label="Target ship">
          {{#if hasTargets}}{{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}{{else}}<option value="">No enemy ships</option>{{/if}}
        </select>
        <button type="button" data-use-canvas-target {{#unless hasTargets}}disabled{{/unless}} title="Use canvas target"><i class="fa-solid fa-crosshairs"></i></button>
        <button type="button" data-lock-target {{#unless target}}disabled{{/unless}} title="Target on canvas"><i class="fa-solid fa-bullseye"></i></button>
        <button type="button" class="afcs-weapon-arc-toggle {{#if arcVisible}}is-active{{/if}}" data-toggle-all-arcs title="{{arcButtonLabel}}"><i class="fa-solid fa-wave-square"></i> {{arcButtonLabel}}</button>
      </div>
      {{#if target}}
      <div class="afcs-target-summary {{#if target.legal}}is-legal{{else}}is-illegal{{/if}}">
        <img src="{{target.img}}" alt="{{target.name}}">
        <div><strong>{{target.name}}</strong><span>AC {{target.armorClass}} · Hardness {{target.hardness}} · Hull {{target.hullValue}}/{{target.hullMax}}</span><small>{{target.solutionText}}</small></div>
      </div>
      {{/if}}
      <div class="afcs-weapon-groups">
        {{#if hasWeapons}}
          {{#each weaponGroups}}
            <section class="afcs-weapon-group {{colorClass}}"><h4>{{label}}</h4>
              {{#each weapons}}
                <article class="afcs-weapon-row {{#unless ready}}is-reloading{{/unless}} {{#unless legal}}is-illegal{{/unless}}">
                  <div class="afcs-weapon-text"><strong>{{name}}</strong><span>{{mountLabel}} {{mountIndex}} · {{damage}} · {{fireAP}} AP</span><small>{{solution}}</small></div>
                  <div class="afcs-weapon-meta"><em>{{statusLabel}}</em><button type="button" class="afcs-weapon-row-arc {{#if arcVisible}}is-active{{/if}}" data-toggle-weapon-arc="{{key}}" title="{{arcButtonLabel}} for {{name}}"><i class="fa-solid fa-wave-square"></i> {{arcButtonLabel}}</button>{{#if ready}}<button type="button" data-fire-weapon="{{key}}" {{#unless canFire}}disabled{{/unless}} title="{{#if canFire}}Fire this weapon{{else}}Battlewatch crew only, during this ship's active turn, with a legal target and enough AP{{/if}}">Fire</button>{{else}}<button type="button" data-work-weapon="{{key}}" {{#unless canReload}}disabled{{/unless}} title="{{#if canReload}}Common action: spend 1 AP to reduce remaining Reload by 1 round{{else}}Assigned crew only, during this ship's active turn, with enough AP{{/if}}"><i class="fa-solid fa-rotate"></i> Reload</button>{{#if canWorkGuns}}<button type="button" data-work-guns="{{key}}" title="Battlewatch, once per round: spend 1 Morale and gain 1 Strain to immediately ready this weapon for 0 AP"><i class="fa-solid fa-burst"></i> Work the Guns</button>{{/if}}{{/if}}</div>
                </article>
              {{/each}}
            </section>
          {{/each}}
        {{else}}<div class="afcs-empty-state">No installed weapons are available.</div>{{/if}}
      </div>
    </section>

    <section class="afcs-drawer afcs-drawer-log {{#if openLog}}is-open{{/if}}">
      <header><div><span>COMBAT LOG</span><strong>{{shipName}}</strong></div><button type="button" data-toggle-panel="log"><i class="fa-solid fa-xmark"></i></button></header>
      <div class="afcs-log-list">
        {{#if logEntries.length}}{{#each logEntries}}<article class="afcs-log-entry {{tone}}"><i class="{{icon}}"></i><div><strong>{{title}}</strong><span>{{detail}}</span></div></article>{{/each}}{{else}}<div class="afcs-empty-state">No ship-combat entries yet.</div>{{/if}}
      </div>
    </section>

    {{#if showUndoControls}}
    <nav class="afch-undo-controls" aria-label="Undo ship movement">
      <span><i class="fa-solid fa-clock-rotate-left"></i> Turn Position</span>
      <button type="button" data-undo-move {{#unless canUndoMove}}disabled{{/unless}} title="Return to this turn's starting position without refunding AP"><i class="fa-solid fa-arrow-rotate-left"></i> Undo Move</button>
      <button type="button" data-undo-facing {{#unless canUndoFacing}}disabled{{/unless}} title="Return to this turn's starting facing without refunding AP"><i class="fa-solid fa-rotate-left"></i> Undo Facing</button>
      <button type="button" data-reset-turn-position {{#unless canResetTurnPosition}}disabled{{/unless}} title="Return both position and facing to the start of this turn"><i class="fa-solid fa-backward-fast"></i> Reset Both</button>
    </nav>
    {{/if}}

    <footer class="afcs-commandbar {{#if activeTurn}}is-active-turn{{/if}}">
      <section class="afch-ship">
        {{#if shipImg}}<img src="{{shipImg}}" alt="{{shipName}}">{{/if}}
        <div>
          <strong>{{shipName}}</strong>
          <small>{{#if activeTurn}}Active Turn{{else}}Standby{{/if}}</small>
        </div>
      </section>

      <section class="afch-status" aria-label="Combat status">
        <div class="afch-stat"><label>Round</label><strong>{{resources.round}}</strong></div>
        <div class="afch-stat ap"><label>Action Points</label><strong>AP {{resources.ap}} / {{resources.apMax}}</strong></div>
        <div class="afch-stat rp"><label>Reaction Points</label><strong>RP {{resources.rp}} / {{resources.rpMax}}</strong></div>
        <div class="afch-stat strain"><label>Strain</label><strong>{{resources.strain}} / {{resources.strainMax}}</strong></div>
        <div class="afch-stat"><label>Heading</label><strong>{{resources.heading}}°</strong></div>
      </section>

      <section class="afch-target">
        <span class="afch-kicker">Target</span>
        <strong>{{targetName}}</strong>
        <small>{{#if target}}{{target.solutionText}}{{else}}No firing solution{{/if}}</small>
      </section>

      <button type="button" class="afch-close" data-afch-close title="Close combat HUD" aria-label="Close combat HUD"><i class="fa-solid fa-xmark"></i></button>

      <section class="afch-vitals" aria-label="Ship resources">
        <div class="afch-vital hull" data-afch-vital="hull"><label>Hull</label><div class="afch-meter"><i></i></div><strong>— / —</strong></div>
        <div class="afch-vital lifeveil" data-afch-vital="lifeveil"><label>Lifeveil</label><div class="afch-meter"><i></i></div><strong>— / —</strong></div>
        <div class="afch-vital morale" data-afch-vital="morale"><label>Morale</label><div class="afch-meter"><i></i></div><strong>— / —</strong></div>
        <div class="afch-vital strain" data-afch-vital="strain"><label>Strain</label><div class="afch-meter"><i></i></div><strong>— / —</strong></div>
        <div class="afch-vital supplies" data-afch-vital="supplies"><label>Supplies</label><div class="afch-meter"><i></i></div><strong>— / —</strong></div>
      </section>

      <nav class="afch-stations" aria-label="Ship stations">
        {{#each stationRows}}
          <button type="button" data-command-station="{{id}}" class="{{#if active}}is-active{{/if}}" title="{{label}} — {{crew}}"><i class="{{icon}}"></i> {{label}}</button>
        {{/each}}
      </nav>

      <nav class="afch-actions" aria-label="Combat controls">
        <button type="button" class="{{#if openWeapons}}is-active{{/if}}" data-toggle-panel="weapons"><i class="fa-solid fa-sword"></i> Weapons</button>
        <button type="button" class="{{#if arcVisible}}is-active{{/if}}" data-toggle-all-arcs title="{{arcButtonLabel}}"><i class="fa-solid fa-wave-square"></i> Weapon Arcs</button>
        <button type="button" class="{{#if openLog}}is-active{{/if}}" data-toggle-panel="log"><i class="fa-solid fa-scroll"></i> Log</button>
        <button type="button" class="is-end" data-end-turn {{#unless canEndTurn}}disabled{{/unless}} title="{{#if canEndTurn}}End this ship's active turn{{else}}Only the GM or an owner of the active ship can end this turn{{/if}}"><i class="fa-solid fa-forward-step"></i> End Turn</button>
      </nav>
    </footer>
  {{/if}}
</section>
