<section class="arkflight-reward-shell">
  {{#if empty}}
    <div class="arkflight-empty"><h2>No completed Arkflight Event</h2></div>
  {{else}}
    <header class="arkflight-reward-header">
      <div class="arkflight-kicker">EVENT OUTCOME</div>
      <h1>{{ending.label}}</h1>
      <p>{{event.title}}</p>
    </header>

    <article class="arkflight-ending-vignette">
      <div class="arkflight-kicker">CLOSING CINEMATIC</div>
      <p>{{ending.vignette}}</p>
    </article>

    <section class="arkflight-reward-section">
      <div class="arkflight-kicker">REWARDS</div>
      {{#if hasRewards}}
        <div class="arkflight-reward-list">
          {{#each rewardRows}}
            <div class="arkflight-reward-row arkflight-reward-{{type}}">
              <strong>{{label}}</strong>
              {{#if detail}}<span>{{detail}}</span>{{/if}}
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="arkflight-muted">No material reward is authored for this outcome.</p>
      {{/if}}
      {{#if edgeOverflow}}
        <div class="arkflight-reward-warning"><i class="fa-solid fa-triangle-exclamation"></i> The shared Crew Tactics pool is full. Resolve the overflow before carrying rewards forward.</div>
      {{/if}}

      {{#if isGM}}
        {{#if hasGrantableRewards}}
          {{#if rewardsGranted}}
            <div class="arkflight-reward-granted"><i class="fa-solid fa-check"></i> Event rewards granted to <strong>{{rewardRecipientName}}</strong>.</div>
          {{else}}
            <div class="arkflight-reward-grant-controls">
              {{#if hasPf2eGrantableRewards}}
                <label>
                  <span>PF2e Reward Recipient</span>
                  <select data-ark-reward-recipient>
                    <option value="">Choose character / party / loot actor…</option>
                    {{#each recipients}}
                      <option value="{{id}}">{{name}} · {{type}}</option>
                    {{/each}}
                  </select>
                </label>
              {{/if}}
              {{#if hasAetherScrapReward}}
                <div class="arkflight-reward-scrap-target"><strong>Aether Scrap → {{#if activeShipName}}{{activeShipName}}{{else}}No active ship bound{{/if}}</strong></div>
              {{/if}}
              {{#if hasShipRewards}}
                <div class="arkflight-reward-scrap-target"><strong>Blueprints / ship components → {{#if activeShipName}}{{activeShipName}}{{else}}No active ship bound{{/if}}</strong></div>
              {{/if}}
              {{#if hasCampaignRewards}}
                <div class="arkflight-reward-scrap-target"><strong>Route knowledge / faction favor / boons → Campaign Ledger</strong></div>
              {{/if}}
              <button type="button" class="arkflight-primary" data-ark-action="grant-pf2e-rewards"><i class="fa-solid fa-box-open"></i> Grant Event Rewards</button>
              <small>PF2e treasure goes to the selected recipient. Aether Scrap, direct blueprints, and physical ship components go to the active ship. Route knowledge, faction rewards, and boons persist to the world campaign ledger. Unresolved ship reward tables/choices are queued for Recovery.</small>
            </div>
          {{/if}}
        {{/if}}
      {{/if}}
    </section>

    <section class="arkflight-edge-hand">
      <div class="arkflight-kicker">CREW TACTICS — {{edgeHandCount}} / 3</div>
      {{#if edgeHand.length}}
        <div class="arkflight-edge-grid">
          {{#each edgeHand}}
            <article class="arkflight-edge-card">
              <header><i class="fa-solid fa-bolt"></i> {{name}}</header>
              <div><b>Trigger:</b> {{trigger}}</div>
              <div><b>Spend:</b> {{effect}}</div>
            </article>
          {{/each}}
        </div>
      {{else}}
        <p class="arkflight-muted">The crew currently holds no Ready Tactics.</p>
      {{/if}}
    </section>

    <footer class="arkflight-reward-note">
      Character treasure is granted through PF2e Item documents. Aether Scrap, direct blueprints, and physical components belong to the active Arkflight ship. Route knowledge, faction rewards, and boons belong to the Arkflight campaign ledger. Crew Tactics remain in the shared Crew Tactics pool.
    </footer>
  {{/if}}
</section>
