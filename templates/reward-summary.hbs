<section class="arkflight-reward-shell">
  {{#if empty}}
    <div class="arkflight-empty"><h2>No completed Arkflight Event</h2></div>
  {{else}}
    <header class="arkflight-reward-header">
      <div class="arkflight-kicker">EVENT OUTCOME</div>
      <h1>{{ending.label}}</h1>
      <p>{{event.title}}</p>
    </header>

    <article class="arkflight-ending-vignette">
      <div class="arkflight-kicker">CLOSING CINEMATIC</div>
      <p>{{ending.vignette}}</p>
    </article>

    <section class="arkflight-reward-section">
      <div class="arkflight-kicker">REWARDS</div>
      {{#if hasRewards}}
        <div class="arkflight-reward-list">
          {{#each rewardRows}}
            <div class="arkflight-reward-row arkflight-reward-{{type}}">
              <strong>{{label}}</strong>
              {{#if detail}}<span>{{detail}}</span>{{/if}}
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="arkflight-muted">No material reward is authored for this outcome.</p>
      {{/if}}
      {{#if edgeOverflow}}
        <div class="arkflight-reward-warning"><i class="fa-solid fa-triangle-exclamation"></i> The shared Crew Edge hand is full. Resolve the overflow before carrying rewards forward.</div>
      {{/if}}

      {{#if isGM}}
        {{#if rewardsGranted}}
          <div class="arkflight-reward-granted"><i class="fa-solid fa-check"></i> PF2e rewards granted to <strong>{{rewardRecipientName}}</strong>.</div>
        {{else}}
          <div class="arkflight-reward-grant-controls">
            <label>
              <span>PF2e Reward Recipient</span>
              <select data-ark-reward-recipient>
                <option value="">Choose character / party / loot actor…</option>
                {{#each recipients}}
                  <option value="{{id}}">{{name}} · {{type}}</option>
                {{/each}}
              </select>
            </label>
            <button type="button" class="arkflight-primary" data-ark-action="grant-pf2e-rewards"><i class="fa-solid fa-box-open"></i> Grant PF2e Rewards</button>
            <small>Gold becomes native PF2e Gold Pieces. Salvage and valuables become native PF2e treasure Items. Authored PF2e compendium items are cloned into the recipient inventory.</small>
          </div>
        {{/if}}
      {{/if}}
    </section>

    <section class="arkflight-edge-hand">
      <div class="arkflight-kicker">CREW EDGE — {{edgeHandCount}} / 3</div>
      {{#if edgeHand.length}}
        <div class="arkflight-edge-grid">
          {{#each edgeHand}}
            <article class="arkflight-edge-card">
              <header><i class="fa-solid fa-bolt"></i> {{name}}</header>
              <div><b>Trigger:</b> {{trigger}}</div>
              <div><b>Cash In:</b> {{effect}}</div>
            </article>
          {{/each}}
        </div>
      {{else}}
        <p class="arkflight-muted">The crew currently holds no Edge cards.</p>
      {{/if}}
    </section>

    <footer class="arkflight-reward-note">
      Character treasure is granted through PF2e Item documents. Arkflight ship components, faction rewards, route knowledge, boons, and Crew Edge remain in their own Arkflight campaign layers.
    </footer>
  {{/if}}
</section>
