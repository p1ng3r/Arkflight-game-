<form class="arkflight-ship-shell {{cssClass}}" autocomplete="off">
  <header class="arkflight-ship-header arkflight-ship-header-v2">
    <section class="arkflight-header-vessel">
      <div class="arkflight-header-vessel-top">
        <div class="arkflight-ship-portrait-frame">
          <img class="arkflight-ship-portrait" src="{{arkflight.actorImg}}" alt="{{actor.name}}">
        </div>
        <div class="arkflight-ship-identity">
          <div class="arkflight-ship-kicker">ARKFLIGHT VESSEL</div>
          <div class="arkflight-ship-name-row"><h1>{{actor.name}}</h1><span class="arkflight-tier">LEVEL {{arkflight.level}}</span></div>
          <div class="arkflight-ship-registry-row"><span>{{arkflight.hullName}}</span><span>{{arkflight.hullPatternName}}</span>{{#if arkflight.ship.identity.registry}}<span>REG {{arkflight.ship.identity.registry}}</span>{{/if}}{{#if arkflight.ship.identity.callsign}}<span>CALLSIGN {{arkflight.ship.identity.callsign}}</span>{{/if}}</div>
          <div class="arkflight-powertrain-line"><strong>{{arkflight.arkengineName}}</strong><span>{{arkflight.arkenginePatternName}}</span></div>
        </div>
      </div>
      <div class="arkflight-ship-xp-host" data-ship-xp-host></div>
    </section>

    <section class="arkflight-header-voyage">
      <div class="arkflight-header-section-label">VOYAGE STATUS</div>
      <div class="arkflight-ship-header-actions">
        <div class="arkflight-readiness {{arkflight.validation.statusClass}}"><i class="fa-solid {{#if arkflight.validation.ok}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}}"></i> {{arkflight.validation.label}}</div>
        <div class="arkflight-access-note">{{#if arkflight.canManageRefit}}REFIT AUTHORIZED{{else}}REFIT VIEW ONLY{{/if}}</div>
      </div>
    </section>

    <section class="arkflight-header-status" data-operational-status-host></section>
  </header>

  <nav class="arkflight-sheet-tabs" aria-label="Arkflight ship sheet sections">
    <button type="button" data-tab="overview" class="{{#if arkflight.tab.overview}}is-active{{/if}}"><i class="fa-solid fa-gauge-high"></i> Overview</button>
    <button type="button" data-tab="hold" data-hold-tab class="{{#if arkflight.tab.hold}}is-active{{/if}}"><i class="fa-solid fa-box-open"></i> Hold</button>
    <button type="button" data-tab="combat" class="{{#if arkflight.tab.combat}}is-active{{/if}}"><i class="fa-solid fa-crosshairs"></i> Combat</button>
    <button type="button" data-open-shipwright><i class="fa-solid fa-hammer"></i> Shipwright</button>
  </nav>

  {{#unless arkflight.validation.ok}}
    <section class="arkflight-readiness-banner"><strong><i class="fa-solid fa-triangle-exclamation"></i> {{arkflight.validation.label}}</strong><div>{{#each arkflight.validation.errors as |error|}}<span>{{error}}</span>{{/each}}</div></section>
  {{/unless}}

  {{#if arkflight.tab.hold}}
    <main class="arkflight-hold-log-host" data-hold-log-host></main>
  {{/if}}

  {{#if arkflight.tab.overview}}
    <section class="arkflight-resource-strip">{{#each arkflight.resources as |resource|}}<div class="arkflight-resource-card"><div class="arkflight-resource-label"><i class="fa-solid {{resource.icon}}"></i> {{resource.label}}</div><div class="arkflight-resource-values">{{#if ../arkflight.canOperate}}<input type="number" min="0" max="{{resource.max}}" value="{{resource.value}}" data-resource="{{resource.key}}">{{else}}<strong>{{resource.value}}</strong>{{/if}}<span>/</span><strong>{{resource.max}}</strong></div></div>{{/each}}</section>
    <section class="arkflight-primary-stat-grid">{{#each arkflight.view.stats.primary as |stat|}}<div class="arkflight-stat-card"><span>{{stat.label}}</span><strong>{{stat.value}}</strong></div>{{/each}}</section>
    <section class="arkflight-overview-section">
      <div class="arkflight-panel-heading"><div><span class="arkflight-ship-kicker">OPERATIONAL CORE</span><h2>Ship Areas</h2></div><small>Area state drives its station penalty and immediate consequences.</small></div>
      <div class="arkflight-area-grid">{{#each arkflight.view.areas as |area|}}<article class="arkflight-area-card {{area.stateClass}}"><div class="arkflight-area-heading"><i class="fa-solid {{area.icon}}"></i><strong>{{area.label}}</strong><span>{{area.stateLabel}}</span></div><div class="arkflight-area-station"><span>{{area.stationLabel}}</span><strong>{{area.penaltyLabel}}</strong></div><p>{{area.consequence}}</p></article>{{/each}}</div>
    </section>
    <main class="arkflight-overview-lower-grid">
      <section class="arkflight-command-panel"><div class="arkflight-panel-heading"><div><span class="arkflight-ship-kicker">BRIDGE WATCH</span><h2>Stations &amp; Crew</h2></div></div><div class="arkflight-station-list">{{#each arkflight.view.stations as |station|}}<div class="arkflight-station-card"><div class="arkflight-station-emblem"><i class="fa-solid fa-compass-drafting"></i></div><div><strong>{{station.label}}</strong><span>{{station.assignment}}</span></div></div>{{/each}}</div></section>
      <section class="arkflight-command-panel"><div class="arkflight-panel-heading"><div><span class="arkflight-ship-kicker">VESSEL PROFILE</span><h2>Operational Details</h2></div></div><div class="arkflight-operational-stat-list">{{#each arkflight.view.stats.operational as |stat|}}<div><span>{{stat.label}}</span><strong>{{stat.value}}</strong></div>{{/each}}</div><div class="arkflight-profile-subsection"><h3>Traits</h3><div class="arkflight-chip-row">{{#each arkflight.tags as |tag|}}<span class="arkflight-chip">{{tag}}</span>{{/each}}{{#unless arkflight.tags.length}}<span class="arkflight-empty-text">No derived traits.</span>{{/unless}}</div></div><div class="arkflight-profile-subsection"><h3>Capabilities</h3><div class="arkflight-chip-row">{{#each arkflight.capabilities as |capability|}}<span class="arkflight-chip arkflight-capability-chip">{{capability}}</span>{{/each}}{{#unless arkflight.capabilities.length}}<span class="arkflight-empty-text">No component capabilities.</span>{{/unless}}</div></div></section>
    </main>
  {{/if}}

  {{#if arkflight.tab.combat}}
    <main class="arkflight-combat-stations-host" data-combat-stations-host></main>
  {{/if}}
</form>
