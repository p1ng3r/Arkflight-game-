<form class="arkflight-ship-shell {{cssClass}}" autocomplete="off">
  <header class="arkflight-ship-header arkflight-ship-header-v2">
    <section class="arkflight-header-vessel">
      <div class="arkflight-header-vessel-top">
        <div class="arkflight-ship-portrait-frame">
          <img class="arkflight-ship-portrait" src="{{arkflight.actorImg}}" alt="{{actor.name}}">
        </div>
        <div class="arkflight-ship-identity">
          <div class="arkflight-ship-kicker">ARKFLIGHT VESSEL</div>
          <div class="arkflight-ship-name-row"><h1>{{actor.name}}</h1><span class="arkflight-tier">LEVEL {{arkflight.level}}</span></div>
          <div class="arkflight-ship-registry-row"><span>{{arkflight.hullName}}</span><span>{{arkflight.hullPatternName}}</span>{{#if arkflight.ship.identity.registry}}<span>REG {{arkflight.ship.identity.registry}}</span>{{/if}}{{#if arkflight.ship.identity.callsign}}<span>CALLSIGN {{arkflight.ship.identity.callsign}}</span>{{/if}}</div>
          <div class="arkflight-powertrain-line"><strong>{{arkflight.arkengineName}}</strong><span>{{arkflight.arkenginePatternName}}</span></div>
        </div>
      </div>
      <div class="arkflight-ship-xp-host" data-ship-xp-host></div>
    </section>

    <section class="arkflight-header-voyage">
      <div class="arkflight-header-section-label">VOYAGE STATUS</div>
      <div class="arkflight-ship-header-actions">
        <div class="arkflight-readiness {{arkflight.validation.statusClass}}"><i class="fa-solid {{#if arkflight.validation.ok}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}}"></i> {{arkflight.validation.label}}</div>
        <div class="arkflight-access-note">{{#if arkflight.canManageRefit}}REFIT AUTHORIZED{{else}}REFIT VIEW ONLY{{/if}}</div>
      </div>
    </section>

    <section class="arkflight-header-status" data-operational-status-host></section>
  </header>

  <nav class="arkflight-sheet-tabs" aria-label="Arkflight ship sheet sections">
    <button type="button" data-tab="overview" class="{{#if arkflight.tab.overview}}is-active{{/if}}"><i class="fa-solid fa-gauge-high"></i> Overview</button>
    <button type="button" data-tab="fittings" class="{{#if arkflight.tab.fittings}}is-active{{/if}}"><i class="fa-solid fa-screwdriver-wrench"></i> Fittings</button>
    <button type="button" data-tab="refit" class="{{#if arkflight.tab.refit}}is-active{{/if}}"><i class="fa-solid fa-hammer"></i> Refit</button>
  </nav>

  {{#unless arkflight.validation.ok}}
    <section class="arkflight-readiness-banner"><strong><i class="fa-solid fa-triangle-exclamation"></i> {{arkflight.validation.label}}</strong><div>{{#each arkflight.validation.errors as |error|}}<span>{{error}}</span>{{/each}}</div></section>
  {{/unless}}

  {{#if arkflight.tab.overview}}
    <section class="arkflight-resource-strip">{{#each arkflight.resources as |resource|}}<div class="arkflight-resource-card"><div class="arkflight-resource-label"><i class="fa-solid {{resource.icon}}"></i> {{resource.label}}</div><div class="arkflight-resource-values">{{#if ../arkflight.canOperate}}<input type="number" min="0" max="{{resource.max}}" value="{{resource.value}}" data-resource="{{resource.key}}">{{else}}<strong>{{resource.value}}</strong>{{/if}}<span>/</span><strong>{{resource.max}}</strong></div></div>{{/each}}</section>
    <section class="arkflight-primary-stat-grid">{{#each arkflight.view.stats.primary as |stat|}}<div class="arkflight-stat-card"><span>{{stat.label}}</span><strong>{{stat.value}}</strong></div>{{/each}}</section>
    <section class="arkflight-overview-section">
      <div class="arkflight-panel-heading"><div><span class="arkflight-ship-kicker">OPERATIONAL CORE</span><h2>Ship Areas</h2></div><small>Area state drives its station penalty and immediate consequences.</small></div>
      <div class="arkflight-area-grid">{{#each arkflight.view.areas as |area|}}<article class="arkflight-area-card {{area.stateClass}}"><div class="arkflight-area-heading"><i class="fa-solid {{area.icon}}"></i><strong>{{area.label}}</strong><span>{{area.stateLabel}}</span></div><div class="arkflight-area-station"><span>{{area.stationLabel}}</span><strong>{{area.penaltyLabel}}</strong></div><p>{{area.consequence}}</p></article>{{/each}}</div>
    </section>
    <main class="arkflight-overview-lower-grid">
      <section class="arkflight-command-panel"><div class="arkflight-panel-heading"><div><span class="arkflight-ship-kicker">BRIDGE WATCH</span><h2>Stations &amp; Crew</h2></div></div><div class="arkflight-station-list">{{#each arkflight.view.stations as |station|}}<div class="arkflight-station-card"><div class="arkflight-station-emblem"><i class="fa-solid fa-compass-drafting"></i></div><div><strong>{{station.label}}</strong><span>{{station.assignment}}</span></div></div>{{/each}}</div></section>
      <section class="arkflight-command-panel"><div class="arkflight-panel-heading"><div><span class="arkflight-ship-kicker">VESSEL PROFILE</span><h2>Operational Details</h2></div></div><div class="arkflight-operational-stat-list">{{#each arkflight.view.stats.operational as |stat|}}<div><span>{{stat.label}}</span><strong>{{stat.value}}</strong></div>{{/each}}</div><div class="arkflight-profile-subsection"><h3>Traits</h3><div class="arkflight-chip-row">{{#each arkflight.tags as |tag|}}<span class="arkflight-chip">{{tag}}</span>{{/each}}{{#unless arkflight.tags.length}}<span class="arkflight-empty-text">No derived traits.</span>{{/unless}}</div></div><div class="arkflight-profile-subsection"><h3>Capabilities</h3><div class="arkflight-chip-row">{{#each arkflight.capabilities as |capability|}}<span class="arkflight-chip arkflight-capability-chip">{{capability}}</span>{{/each}}{{#unless arkflight.capabilities.length}}<span class="arkflight-empty-text">No component capabilities.</span>{{/unless}}</div></div></section>
    </main>
  {{/if}}

  {{#if arkflight.tab.fittings}}
    <main class="arkflight-sheet-section">
      <div class="arkflight-panel-heading"><div><span class="arkflight-ship-kicker">INSTALLED HARDWARE</span><h2>Fittings</h2></div><small>Only installed hardware is shown here. Full catalogs live in Compendiums.</small></div>
      <details class="arkflight-fitting-section" open><summary><span>Hull &amp; Arkengine</span><button type="button" data-compendium-pack="{{arkflight.view.compendiums.hulls}}">Browse Hulls</button><button type="button" data-compendium-pack="{{arkflight.view.compendiums.arkengines}}">Browse Arkengines</button></summary><div class="arkflight-installed-grid">{{#if arkflight.view.fittings.hull}}<article class="arkflight-installed-card"><span>HULL</span><strong>{{arkflight.view.fittings.hull.name}}</strong><small>{{arkflight.view.fittings.hull.patternName}}</small><p>{{arkflight.view.fittings.hull.description}}</p></article>{{/if}}{{#if arkflight.view.fittings.arkengine}}<article class="arkflight-installed-card"><span>ARKENGINE</span><strong>{{arkflight.view.fittings.arkengine.name}}</strong><small>{{arkflight.view.fittings.arkengine.patternName}}</small><p>{{arkflight.view.fittings.arkengine.description}}</p></article>{{/if}}</div></details>
      <details class="arkflight-fitting-section {{#if arkflight.fittingCapacity.shipMods.over}}is-over-capacity{{/if}}" open><summary><span>Ship Mods</span><strong>{{arkflight.fittingCapacity.shipMods.text}}</strong><button type="button" data-compendium-pack="{{arkflight.view.compendiums.shipMods}}">Browse Compendium</button></summary>{{#if arkflight.fittingCapacity.shipMods.over}}<div class="arkflight-capacity-warning"><i class="fa-solid fa-triangle-exclamation"></i> Remove {{arkflight.fittingCapacity.shipMods.overBy}} slot of installed Ship Mods before adding another fitting.</div>{{/if}}<div class="arkflight-installed-grid">{{#each arkflight.view.fittings.shipMods as |item|}}<article class="arkflight-installed-card"><span>{{item.rarity}}{{#if item.quantity}} · x{{item.quantity}}{{/if}}</span><strong>{{item.name}}</strong><small>{{item.capacityCost}} slot each</small><p>{{item.description}}</p>{{#if ../arkflight.canManageRefit}}<button type="button" class="arkflight-refit-action" data-refit-remove data-family="shipMod" data-id="{{item.id}}"><i class="fa-solid fa-arrow-right-from-bracket"></i> Remove One</button>{{/if}}</article>{{/each}}{{#unless arkflight.view.fittings.shipMods.length}}<p class="arkflight-empty-text">No Ship Mods installed.</p>{{/unless}}</div></details>
      <details class="arkflight-fitting-section {{#if arkflight.fittingCapacity.arkengineMods.over}}is-over-capacity{{/if}}" open><summary><span>Arkengine Mods</span><strong>{{arkflight.fittingCapacity.arkengineMods.text}}</strong><button type="button" data-compendium-pack="{{arkflight.view.compendiums.arkengineMods}}">Browse Compendium</button></summary>{{#if arkflight.fittingCapacity.arkengineMods.over}}<div class="arkflight-capacity-warning"><i class="fa-solid fa-triangle-exclamation"></i> Remove {{arkflight.fittingCapacity.arkengineMods.overBy}} slot of Arkengine Mods before installing another fitting.</div>{{/if}}<div class="arkflight-installed-grid">{{#each arkflight.view.fittings.arkengineMods as |item|}}<article class="arkflight-installed-card"><span>{{item.rarity}}{{#if item.quantity}} · x{{item.quantity}}{{/if}}</span><strong>{{item.name}}</strong><small>{{item.capacityCost}} slot each</small><p>{{item.description}}</p>{{#if ../arkflight.canManageRefit}}<button type="button" class="arkflight-refit-action" data-refit-remove data-family="arkengineMod" data-id="{{item.id}}"><i class="fa-solid fa-arrow-right-from-bracket"></i> Remove One</button>{{/if}}</article>{{/each}}{{#unless arkflight.view.fittings.arkengineMods.length}}<p class="arkflight-empty-text">No Arkengine Mods installed.</p>{{/unless}}</div></details>
      <details class="arkflight-fitting-section"><summary><span>Rooms</span><strong>{{arkflight.fittingCapacity.rooms.text}}</strong><button type="button" data-compendium-pack="{{arkflight.view.compendiums.rooms}}">Browse Compendium</button></summary><div class="arkflight-installed-grid">{{#each arkflight.view.fittings.rooms as |item|}}<article class="arkflight-installed-card"><strong>{{item.name}}{{#if item.quantity}} ×{{item.quantity}}{{/if}}</strong><p>{{item.description}}</p></article>{{/each}}{{#unless arkflight.view.fittings.rooms.length}}<p class="arkflight-empty-text">No expansion Rooms installed.</p>{{/unless}}</div></details>
      <details class="arkflight-fitting-section"><summary><span>Weapons</span><button type="button" data-compendium-pack="{{arkflight.view.compendiums.weapons}}">Browse Compendium</button></summary><div class="arkflight-installed-grid">{{#each arkflight.view.fittings.weapons as |item|}}<article class="arkflight-installed-card"><strong>{{item.name}}{{#if item.quantity}} ×{{item.quantity}}{{/if}}</strong><p>{{item.description}}</p></article>{{/each}}{{#unless arkflight.view.fittings.weapons.length}}<p class="arkflight-empty-text">No ship weapons installed.</p>{{/unless}}</div></details>
      <details class="arkflight-fitting-section"><summary><span>Talents</span><button type="button" data-compendium-pack="{{arkflight.view.compendiums.talents}}">Browse Compendium</button></summary><div class="arkflight-installed-grid">{{#each arkflight.view.fittings.talents as |item|}}<article class="arkflight-installed-card"><strong>{{item.name}}</strong><p>{{item.description}}</p></article>{{/each}}{{#unless arkflight.view.fittings.talents.length}}<p class="arkflight-empty-text">No Ship Talents selected.</p>{{/unless}}</div></details>
    </main>
  {{/if}}

  {{#if arkflight.tab.refit}}
    <main class="arkflight-sheet-section">
      <div class="arkflight-panel-heading"><div><span class="arkflight-ship-kicker">SHIPYARD &amp; CREW WORK</span><h2>Refit</h2></div><small>{{#if arkflight.canManageRefit}}You may manage authorized Refit work.{{else}}View-only: a GM or owning user must manage Refit work.{{/if}}</small></div>
      <section class="arkflight-refit-summary-grid"><article><span>Ship Mod Inventory</span><strong>{{arkflight.view.refit.shipMods.length}}</strong></article><article><span>Arkengine Mod Inventory</span><strong>{{arkflight.view.refit.arkengineMods.length}}</strong></article><article><span>Active Work Orders</span><strong>{{arkflight.view.refit.workOrders.length}}</strong></article><article><span>Completed History</span><strong>{{arkflight.view.refit.history.length}}</strong></article></section>
      <section class="arkflight-refit-panel"><div class="arkflight-panel-heading"><div><span class="arkflight-ship-kicker">PHYSICAL FITTINGS</span><h2>Owned Inventory</h2></div></div><div class="arkflight-installed-grid">
        {{#each arkflight.view.refit.shipMods as |item|}}<article class="arkflight-installed-card"><span>SHIP MOD · x{{item.quantity}}</span><strong>{{item.name}}</strong><p>{{item.description}}</p>{{#if ../arkflight.canManageRefit}}<div class="arkflight-refit-actions"><button type="button" data-refit-install data-family="shipMod" data-id="{{item.id}}" data-method="crew">Crew Install</button><button type="button" data-refit-install data-family="shipMod" data-id="{{item.id}}" data-method="shipyard">Shipyard Install</button></div>{{/if}}</article>{{/each}}
        {{#each arkflight.view.refit.arkengineMods as |item|}}<article class="arkflight-installed-card"><span>ARKENGINE MOD · x{{item.quantity}}</span><strong>{{item.name}}</strong><p>{{item.description}}</p>{{#if ../arkflight.canManageRefit}}<div class="arkflight-refit-actions"><button type="button" data-refit-install data-family="arkengineMod" data-id="{{item.id}}" data-method="crew">Crew Install</button><button type="button" data-refit-install data-family="arkengineMod" data-id="{{item.id}}" data-method="shipyard">Shipyard Install</button></div>{{/if}}</article>{{/each}}
        {{#unless arkflight.view.refit.shipMods.length}}{{#unless arkflight.view.refit.arkengineMods.length}}<p class="arkflight-empty-text">No physical Mod fittings are currently stored aboard.</p>{{/unless}}{{/unless}}
      </div></section>
      <section class="arkflight-refit-panel"><div class="arkflight-panel-heading"><div><span class="arkflight-ship-kicker">KNOWN DESIGNS</span><h2>Blueprints</h2></div></div><div class="arkflight-installed-grid">
        {{#each arkflight.view.refit.blueprints.shipMods as |item|}}<article class="arkflight-installed-card"><span>SHIP MOD BLUEPRINT</span><strong>{{item.name}}</strong><p>{{item.description}}</p>{{#if ../arkflight.canManageRefit}}<div class="arkflight-refit-actions"><button type="button" data-refit-build data-family="shipMod" data-id="{{item.id}}" data-method="crew">Build — Crew</button><button type="button" data-refit-build data-family="shipMod" data-id="{{item.id}}" data-method="shipyard">Build — Shipyard</button></div>{{/if}}</article>{{/each}}
        {{#each arkflight.view.refit.blueprints.arkengineMods as |item|}}<article class="arkflight-installed-card"><span>ARKENGINE BLUEPRINT</span><strong>{{item.name}}</strong><p>{{item.description}}</p>{{#if ../arkflight.canManageRefit}}<div class="arkflight-refit-actions"><button type="button" data-refit-build data-family="arkengineMod" data-id="{{item.id}}" data-method="crew">Build — Crew</button><button type="button" data-refit-build data-family="arkengineMod" data-id="{{item.id}}" data-method="shipyard">Build — Shipyard</button></div>{{/if}}</article>{{/each}}
        {{#unless arkflight.view.refit.blueprints.shipMods.length}}{{#unless arkflight.view.refit.blueprints.arkengineMods.length}}<p class="arkflight-empty-text">No Mod blueprints known.</p>{{/unless}}{{/unless}}
      </div></section>
      <section class="arkflight-refit-panel"><div class="arkflight-panel-heading"><div><span class="arkflight-ship-kicker">REFIT QUEUE</span><h2>Active Work Orders</h2></div></div><div class="arkflight-work-order-list">{{#each arkflight.view.refit.workOrders as |order|}}<article><div><strong>{{order.componentName}}</strong><span>{{order.typeLabel}} · {{order.methodLabel}} · {{order.statusLabel}}</span><small>{{order.remainingHours}}h remaining</small></div>{{#if ../arkflight.canManageRefit}}{{#if order.canStart}}<button type="button" data-refit-start="{{order.id}}">Start Work</button>{{/if}}{{/if}}</article>{{/each}}{{#unless arkflight.view.refit.workOrders.length}}<p class="arkflight-empty-text">No active Refit work orders.</p>{{/unless}}</div></section>
      {{#if arkflight.view.refit.history.length}}<details class="arkflight-refit-history"><summary>Completed Work History · {{arkflight.view.refit.history.length}}</summary><div class="arkflight-work-order-list">{{#each arkflight.view.refit.history as |order|}}<article><div><strong>{{order.componentName}}</strong><span>{{order.typeLabel}} · {{order.statusLabel}}</span></div></article>{{/each}}</div></details>{{/if}}
    </main>
  {{/if}}
</form>