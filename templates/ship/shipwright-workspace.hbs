<section class="arkflight-workspace-shell">
  <header class="arkflight-workspace-topbar">
    <div><span>SHIPWRIGHT WORKSPACE</span><h1>{{actorName}}</h1></div>
    <div class="arkflight-workspace-status">
      <span>{{statusLabel}} · {{serviceLabel}}</span>
      <strong>{{scrap}} Aether Scrap</strong>
      {{#if hasPartyTreasury}}<small>Party Treasury {{partyGold}} gp</small>{{/if}}
    </div>
    {{#unless workbench}}<button type="button" data-workbench-home><i class="fa-solid fa-arrow-left"></i> Back to Workbench</button>{{/unless}}
  </header>

  {{#unless serviceAllowed}}
    <div class="arkflight-workspace-service-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{statusLabel}} does not currently permit {{serviceLabel}} installation work. Secure the vessel before beginning a refit.</div>
  {{/unless}}

  {{#if workbench}}
    <section class="arkflight-workbench-stage" aria-label="Shipwright workbench">
      <img class="arkflight-workbench-table-art" src="{{assets.table}}" alt="Shipwright workbench">
      <div class="arkflight-workbench-table-shade" aria-hidden="true"></div>

      <button type="button" class="arkflight-workbench-hotspot is-arkengine" data-workbench-category="arkengine" aria-label="Open Arkengine Mods" title="Open Arkengine Mods">
        <img class="arkflight-workbench-backer" src="{{assets.categories.arkengine.backer}}" alt="">
        <img class="arkflight-workbench-feature" src="{{assets.categories.arkengine.feature}}" alt="Arkengine">
        <img class="arkflight-workbench-hover" src="{{assets.hover}}" alt="">
        <span class="arkflight-workbench-label" style="--label-plaque:url('{{assets.plaque}}')">Arkengine Mods</span>
      </button>

      <button type="button" class="arkflight-workbench-hotspot is-ship" data-workbench-category="ship" aria-label="Open Ship Mods" title="Open Ship Mods">
        <img class="arkflight-workbench-backer" src="{{assets.categories.ship.backer}}" alt="">
        <img class="arkflight-workbench-feature" src="{{assets.categories.ship.feature}}" alt="Ship">
        <img class="arkflight-workbench-hover" src="{{assets.hover}}" alt="">
        <span class="arkflight-workbench-label" style="--label-plaque:url('{{assets.plaque}}')">Ship Mods</span>
      </button>

      <button type="button" class="arkflight-workbench-hotspot is-weapon" data-workbench-category="weapon" aria-label="Open Weapons" title="Open Weapons">
        <img class="arkflight-workbench-backer" src="{{assets.categories.weapon.backer}}" alt="">
        <img class="arkflight-workbench-feature" src="{{assets.categories.weapon.feature}}" alt="Weapons">
        <img class="arkflight-workbench-hover" src="{{assets.hover}}" alt="">
        <span class="arkflight-workbench-label" style="--label-plaque:url('{{assets.plaque}}')">Weapons</span>
      </button>
    </section>
    <p class="arkflight-workbench-help">Select a station on the workbench.</p>
  {{else}}
    <nav class="arkflight-workspace-tabs">
      <button type="button" data-workbench-category="ship" class="{{#if isShip}}is-active{{/if}}">Ship Mods</button>
      <button type="button" data-workbench-category="arkengine" class="{{#if isArkengine}}is-active{{/if}}">Arkengine Mods</button>
      <button type="button" data-workbench-category="weapon" class="{{#if isWeapon}}is-active{{/if}}">Weapons</button>
    </nav>

    <main class="arkflight-workspace-board-layout">
      <section class="arkflight-workspace-board-panel">
        <div class="arkflight-workspace-socket-legend"><strong>SOCKET KEY</strong><span class="is-free">Free</span><span class="is-installed">Installed</span><span class="is-reserved">Reserved / Working</span>{{#if isWeapon}}<em>Weapon sockets show facing and maximum weapon size.</em>{{else}}<em>These are flexible family sockets; fitting type is shown in inventory.</em>{{/if}}</div>
        <div class="arkflight-workspace-board-stage">
          <img class="arkflight-workspace-board-art" src="{{boardArt}}" alt="Fitting board">
          <div class="arkflight-workspace-socket-layer">
            {{#each sockets as |socket|}}
              <button type="button" class="arkflight-workspace-socket {{#if socket.mount}}is-{{socket.mount.facing}}{{/if}} {{#if socket.labelAbove}}is-label-above{{/if}} {{#if socket.available}}is-available{{/if}} {{#if socket.occupied}}is-occupied{{/if}} {{#if socket.reserved}}is-reserved{{/if}} {{#if socket.working}}is-working{{/if}} {{#if socket.selected}}is-selected{{/if}} {{#if socket.hasComponentArt}}has-component-art{{/if}}" style="left:{{socket.left}}%;top:{{socket.top}}%" data-workspace-socket data-socket-index="{{socket.index}}" data-occupied="{{socket.occupied}}" data-reserved="{{socket.reserved}}" data-available="{{socket.available}}" title="{{socket.typeLabel}} · {{socket.capacityLabel}} · {{socket.stateLabel}}{{#if socket.componentName}} · {{socket.componentName}} · {{socket.componentEffect}}{{/if}}">
                <img class="arkflight-workspace-socket-base" src="{{socket.art}}" alt="">
                {{#if socket.componentImg}}<img class="arkflight-workspace-socket-component" src="{{socket.componentImg}}" alt="{{socket.componentName}}"><span class="arkflight-workspace-socket-effect"><strong>{{socket.componentName}}</strong><small class="arkflight-workspace-socket-effect-label">Effects / Bonuses</small>{{#each socket.componentBonusLines as |bonus|}}<small class="arkflight-workspace-socket-effect-line">{{bonus}}</small>{{/each}}<em>Right-click to uninstall</em></span>{{/if}}
                {{#if socket.occupied}}
                  <img class="arkflight-workspace-socket-state" src="{{../assets.completed}}" alt="Installed">
                {{else if socket.working}}
                  <img class="arkflight-workspace-socket-state" src="{{../assets.working}}" alt="Work in progress">
                {{else if socket.reserved}}
                  <img class="arkflight-workspace-socket-state" src="{{../assets.reserved}}" alt="Reserved">
                {{else}}
                  <img class="arkflight-workspace-socket-state" src="{{../assets.compatible}}" alt="Available">
                {{/if}}
                <span class="arkflight-socket-number">{{socket.number}}</span>
                {{#if socket.reserved}}<span class="arkflight-socket-job-mark"><i class="fa-solid fa-hourglass-half"></i></span>{{/if}}
                <span class="arkflight-socket-label"><strong>{{socket.typeLabel}}</strong><small>{{socket.capacityLabel}} · {{socket.stateLabel}}</small>{{#if socket.componentName}}<em>{{socket.componentName}}</em>{{/if}}</span>
              </button>
            {{/each}}
          </div>
        </div>
      </section>

      <aside class="arkflight-workspace-sidecol">
        {{#if selectedMount}}
          <section class="arkflight-workspace-mount-inspector {{#if selectedMount.available}}is-available{{else}}is-unavailable{{/if}}">
            <header><div><span>SELECTED SOCKET {{selectedMount.number}}</span><h2>{{selectedMount.heading}}</h2></div><strong>{{selectedMount.stateLabel}}</strong></header>
            <dl><div><dt>Accepts</dt><dd>{{selectedMount.capacityLabel}}</dd></div><div><dt>Contents</dt><dd>{{selectedMount.contents}}</dd></div>{{#if selectedMount.mountLabel}}<div><dt>Mount Rule</dt><dd>{{selectedMount.mountLabel}}</dd></div>{{/if}}</dl>
            {{#if isWeapon}}
              {{#if selectedMount.available}}
                <h3>Weapons That Fit</h3>
                <div class="arkflight-compatible-weapon-list">
                  {{#each compatibleWeapons as |weapon|}}<article class="{{#if weapon.ready}}is-ready{{else if weapon.blueprintKnown}}is-blueprint{{else}}is-unknown{{/if}}"><div><strong>{{weapon.name}}</strong><small>{{weapon.size}} · {{weapon.status}}</small></div>{{#if weapon.ready}}<span>READY</span>{{else if weapon.blueprintKnown}}<span>BUILD</span>{{else}}<span>LOCKED</span>{{/if}}</article>{{/each}}
                  {{#unless hasCompatibleWeapons}}<p>No catalog weapon meets this mount's facing, size, and ship-level rules.</p>{{/unless}}
                </div>
              {{/if}}
            {{/if}}
          </section>
        {{/if}}
        <section class="arkflight-workspace-tray" data-inventory-tray style="--tray-art:url('{{assets.inventoryTray}}')">
          <header>
            <h2>Owned Fittings</h2>
            {{#if hasSelectedSocket}}{{#if selectedSocketAvailable}}<small class="arkflight-selected-socket-note">Socket {{selectedSocket}} is free. Compatible physical fittings are marked READY.</small>{{else}}<small>Socket {{selectedSocket}} is not free. Its contents and state are shown above.</small>{{/if}}{{else}}<small>Select any socket to see its type, state, contents, and compatibility.</small>{{/if}}
          </header>
          <div class="arkflight-workspace-inventory-list">
            {{#each inventory as |item|}}
              <article draggable="{{item.compatible}}" data-fitting-drag data-family="{{item.family}}" data-component-id="{{item.id}}" title="{{item.effectSummary}}" class="{{#if ../hasSelectedSocket}}{{#if item.compatible}}is-compatible{{else}}is-incompatible{{/if}}{{/if}}">
                <div><strong>{{item.name}}</strong><small>{{item.slotClass}} · Physical fitting aboard</small><small class="arkflight-fitting-bonus-label">Bonuses / Effects</small><div class="arkflight-fitting-bonuses">{{#each item.bonusLines as |bonus|}}<span>{{bonus}}</span>{{/each}}</div></div><span>x{{item.quantity}}</span>
                {{#if ../selectedSocketAvailable}}{{#if item.compatible}}<button type="button" data-install-selected><i class="fa-solid fa-hammer"></i> Install in Selected Socket</button>{{else}}<em>Does not fit selected socket</em>{{/if}}{{/if}}
              </article>
            {{/each}}
            {{#unless inventory.length}}<p>No physical fittings of this type are currently aboard.</p>{{/unless}}
          </div>
        </section>

        <section class="arkflight-workspace-tray arkflight-workspace-worktray" style="--tray-art:url('{{assets.workTray}}')">
          <header><h2>Active Work</h2><small>Reserved sockets remain unavailable until their work order resolves.</small></header>
          {{#if hasWorkOrders}}
            <div class="arkflight-workspace-work-list">{{#each workOrders as |job|}}<article class="{{#if job.working}}is-working{{/if}}"><img src="{{../assets.hourglass}}" alt=""><div><strong>{{job.name}}</strong><span>{{job.status}} · {{job.hours}}h remaining · {{job.payment}}</span></div></article>{{/each}}</div>
          {{else}}<p>No active refit work orders.</p>{{/if}}
        </section>
      </aside>
    </main>
  {{/if}}
</section>
