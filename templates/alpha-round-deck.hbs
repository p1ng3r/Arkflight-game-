<section class="round-shell {{#if panelOnly}}is-portrait{{/if}}" data-round-phase="{{s.phase}}">
{{#if panelOnly}}
<article class="round-art-card theme-{{card.theme}}">
<header class="round-card-title"><span>{{#if card}}{{card.band}} · {{card.stationLabel}}{{else}}BATTLE WATCH · FIRING{{/if}}</span><b>{{#if card}}{{card.ap}} AP{{else}}d20{{/if}}</b></header>
<div class="round-art-well">{{#if card}}<img src="{{card.art}}" alt="{{card.name}} artwork">{{else}}<i class="fa-solid fa-crosshairs" aria-hidden="true"></i>{{/if}}<div><h2>{{#if card}}{{card.name}}{{else}}{{pending.attacker}} · battery attack{{/if}}</h2><small>{{ship.name}}</small></div></div>
<div class="round-card-parchment">
{{#if card}}<p>{{card.text}}</p><details><summary>Four roll outcomes</summary>{{#each card.outcomes}}<section class="round-outcome is-{{theme}}"><b>{{label}}</b><p>{{text}}</p></section>{{/each}}</details>{{/if}}
{{#if receipt}}<div class="round-saved-receipt"><strong>Saved result · {{receipt.total}}</strong><span>d20 {{receipt.die}} + modifier {{receipt.modifier}} vs DC {{receipt.dc}}</span></div>{{/if}}
{{#if planningCards}}
{{#if card.needsBattery}}<label>Battery<select data-alpha-battery>{{#each batteries}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · {{status}}</option>{{/each}}</select></label>{{/if}}
{{#if card.movementCard}}<label>Movement option<select data-alpha-adjustment>{{#each adjustments}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
{{#if (eq card.id 'boarding')}}<label>Boarding target<select data-alpha-target><option value="">Choose alongside ship</option>{{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
<p class="round-note">Commit now; the station rolls during resolution. Weapon cards include their printed shot. Normal batteries cost 1 AP later.</p>
{{else}}{{#unless receipt}}
<div class="round-crew-identity">{{#if crewPortrait}}<img src="{{crewPortrait}}" alt="{{crewActor}}">{{/if}}<div><strong>{{crewActor}}</strong><small>{{card.stationLabel}}</small></div></div>
<label>Station skill<select data-round-skill><option value="">Choose a skill…</option>{{#each skills}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
{{#if breakdown}}<div class="round-bonus-total">{{breakdown.name}} · {{breakdown.modifierText}}</div><dl class="round-breakdown">{{#each breakdown.components}}<dt>{{label}}</dt><dd>{{value}}</dd>{{/each}}</dl>{{/if}}
{{/unless}}{{/if}}
{{#if error}}<p class="round-error" role="alert">{{error}}</p>{{/if}}
</div>
<footer class="round-card-controls">
{{#if planningCards}}<button class="round-primary" data-round-action="queue-card" {{#unless canQueue}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>Commit · {{card.ap}} AP</button>{{else}}
{{#if requestId}}<button class="round-roll" data-round-action="roll-crew" {{#unless canSubmitRoll}}disabled{{/unless}} {{#if busy}}disabled{{/if}} aria-label="Roll assigned station check"><i class="fa-solid fa-dice-d20"></i><b>d20</b></button>{{else}}
{{#if isOwnResolve}}<button class="round-roll" data-round-action="resolve-card" {{#unless canResolve}}disabled{{/unless}} {{#if busy}}disabled{{/if}} aria-label="Resolve committed card"><i class="fa-solid fa-dice-d20"></i><b>d20</b></button>{{else}}
{{#if canInstant}}<button class="round-roll" data-round-action="play" {{#if busy}}disabled{{/if}} aria-label="Play Instant and roll"><i class="fa-solid fa-dice-d20"></i><b>d20</b></button>{{else}}<span class="round-note">{{#if receipt}}Resolved once · result saved{{else}}Inspection · wait for an eligible phase{{/if}}</span>{{/if}}{{/if}}{{/if}}{{/if}}
{{#if canSkip}}<button data-round-action="skip-card" title="Discard this card; committed AP stays spent">Skip card</button>{{/if}}<button data-round-action="close-card">Close</button>
</footer></article>
{{else}}
<header class="round-command-header"><div class="round-ship-name"><small>ARKFLIGHT · CREW COMMAND</small>{{#if ship}}<select data-alpha-ship aria-label="Your ship">{{#each ships}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>{{else}}<h2>Build a test battle</h2>{{/if}}</div><div class="round-phase-caption"><b>{{phaseLabel}}</b><small>{{phaseInstruction}}</small></div>{{#if ship}}<div class="round-ap-counter"><b>{{ship.ap}}</b><small>AP</small></div>{{/if}}<button data-round-action="minimize" aria-label="Minimize hand">−</button><details class="round-settings"><summary aria-label="Command settings">⚙</summary><div><button data-alpha-sound>Sound {{#if preferences.sound}}on{{else}}off{{/if}}</button><label>Style<select data-alpha-layout><option value="illustrated" {{#if (eq preferences.layout 'illustrated')}}selected{{/if}}>Illustrated</option><option value="minimalist" {{#if (eq preferences.layout 'minimalist')}}selected{{/if}}>Minimalist</option></select></label><label>Motion<select data-alpha-motion><option value="full" {{#if (eq preferences.preference 'full')}}selected{{/if}}>Full</option><option value="subtle" {{#if (eq preferences.preference 'subtle')}}selected{{/if}}>Subtle</option><option value="off" {{#if (eq preferences.preference 'off')}}selected{{/if}}>Off</option></select></label><button data-round-action="tracker">Phase tracker</button><button data-round-action="crew">Ship / Crew</button><button data-round-action="library">Library / Decks</button>{{#if gm}}<button data-round-action="reset">Reset encounter</button>{{/if}}<button data-round-action="clear-arcs">Clear preview</button></div></details></header>
{{#if error}}<p class="round-error" role="alert">{{error}}</p>{{/if}}
<main class="round-workspace">
{{#unless roundFlow}}
<section class="round-welcome"><h2>The crew card table</h2><p>One shared hand. Plan together, roll at your stations, and fight on the canvas.</p>{{#if gm}}{{#if s}}<p>This encounter uses the earlier alpha rules. Reset to start the new flow with saved ships and crew.</p><button class="round-primary" data-round-action="reset">Reset into new round flow</button>{{else}}<div class="round-builder"><label>Crew hull<select data-round-build="hullId">{{#each hulls}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Enemy hull<select data-round-build="enemyHullId">{{#each hulls}}<option value="{{id}}" {{#if enemySelected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Level<input data-round-build="level" type="number" min="1" max="20" value="{{build.level}}"></label><label>Fleet<select data-round-build="count"><option value="2">2 ships</option><option value="4" {{#if (eq build.count 4)}}selected{{/if}}>4 ships</option></select></label></div><button class="round-primary" data-round-action="start">Build test fleet</button>{{/if}}{{else}}<p>Waiting for the GM to start the battle.</p>{{/if}}</section>
{{else}}
{{#if pendingDiscard}}<div class="round-alert">Cleanup · select {{pendingDiscard}} card(s). {{selectionCount}} selected.<button data-round-action="discard" {{#unless canDiscard}}disabled{{/unless}}>Discard selected</button></div>{{/if}}
{{#if showHand}}<div class="round-hand-table"><aside class="round-deck-stack"><button class="round-draw-deck {{#if canDraw}}is-ready{{/if}}" data-round-action="draw-round" data-alpha-pile="draw" {{#unless canDraw}}disabled{{/unless}} {{#if busy}}disabled{{/if}} aria-label="Draw this round’s card"><span>✦</span><b>{{drawCount}}</b><small>{{#if canDraw}}DRAW{{else}}DECK{{/if}}</small></button><div class="round-hand-limit">{{ship.hand.length}} / {{ship.profile.hand}} hand{{#if handOverflow}}<strong>Discard {{handOverflow}} at Cleanup</strong>{{/if}}</div><details class="round-discard-pile"><summary>Discard · {{ship.discard.length}}</summary>{{#each piles}}<p>{{name}} · {{count}}</p>{{/each}}</details></aside>
<div class="alpha-hand round-hand" aria-label="Shared crew hand">{{#each hand}}<button class="round-hand-card theme-{{theme}} {{#if selected}}is-selected{{/if}} {{#if queued}}is-queued{{/if}} {{#if respondable}}is-respondable{{/if}}" data-alpha-card="{{instanceId}}" aria-pressed="{{selected}}" title="{{name}} · {{ap}} AP"><span class="round-hand-band" title="{{#if burn}}Removed from the encounter when used{{else}}{{#if delayed}}Schedules a later effect{{else}}{{#if (eq timing 'instant')}}Playable in its response window; costs AP{{else}}Commit during card planning{{/if}}{{/if}}{{/if}}">{{band}}</span><b class="round-hand-cost">{{ap}}</b><img src="{{art}}" alt=""><strong>{{name}}</strong><small>{{stationLabel}}</small><span class="round-hand-state">{{#if queued}}COMMITTED{{else}}{{#if respondable}}⚡ RESPOND{{else}}{{#if selected}}RETURN / DISCARD{{else}}{{role}}{{/if}}{{/if}}{{/if}}</span></button>{{else}}<div class="round-empty-hand">No cards in hand. Ready weapons can still fire for AP.</div>{{/each}}</div></div>{{/if}}
{{#if opening}}<div class="round-decision-bar">{{#if canMulligan}}<span>Return up to 2 · {{selectionCount}} selected</span><button class="round-primary" data-round-action="mulligan" {{#unless canConfirmMulligan}}disabled{{/unless}}>Keep / replace selected</button>{{else}}<span>Opening hand kept · waiting for the other ships.</span>{{/if}}</div>{{/if}}
{{#if planningCards}}<section class="round-planning-tray"><div><b>Orders · {{committedAP}} AP committed</b><small>Resolve in this order. Keep AP for firing and Instants.</small></div><ol>{{#each cardPlans}}<li><span>{{index}}</span><b>{{name}}</b><small>{{cost}} AP</small>{{#if canRemove}}<button data-round-action="move-card" data-instance-id="{{instanceId}}" data-direction="-1" {{#if first}}disabled{{/if}} aria-label="Move {{name}} earlier">←</button><button data-round-action="move-card" data-instance-id="{{instanceId}}" data-direction="1" {{#if last}}disabled{{/if}} aria-label="Move {{name}} later">→</button><button data-round-action="unqueue-card" data-instance-id="{{instanceId}}" aria-label="Remove {{name}}">×</button>{{/if}}</li>{{else}}<li class="round-empty-plan">No cards committed. You may keep your hand.</li>{{/each}}</ol>{{#if planLocked}}<b>Plan locked · waiting</b>{{else}}<button class="round-primary" data-round-action="lock-cards" {{#unless canLockCards}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>Lock plan / keep remaining cards</button>{{/if}}</section>{{/if}}
{{#if maneuverStep}}<div class="round-maneuver-table">{{#if canPlan}}<div class="round-maneuver-strip">{{#each routes}}<button data-round-action="route" data-route="{{id}}" class="{{#if selected}}is-selected{{/if}}" {{#if @root.locked}}disabled{{/if}}><span>{{{svg}}}</span><b>{{name}}</b><small>{{ap}} AP</small></button>{{/each}}</div>{{/if}}<div class="round-decision-bar"><span>{{#if locked}}Course locked{{else}}{{route.name}} · {{route.description}}{{/if}}</span>{{#if canPlan}}<button data-round-action="plan" {{#if locked}}disabled{{/if}}>Stage</button>{{/if}}<button class="round-primary" data-round-action="lock" {{#unless canLock}}disabled{{/unless}} {{#if locked}}disabled{{/if}}>Lock maneuver</button>{{#if primary}}{{#if allLocked}}<button data-round-action="confirm-move">Reveal &amp; move fleet</button>{{/if}}{{/if}}</div></div>{{/if}}
{{#if resolvingCards}}<div class="round-resolution-wait"><div class="round-resolution-emblem">✦</div><div><small>STATION RESOLUTION</small><h2>{{currentCardName}}</h2><p>{{phaseInstruction}}</p><button class="round-primary" data-round-action="inspect-current">Open station card / Roll</button>{{#if crewRequest.canCancel}}<button data-round-action="cancel-crew">Cancel request</button>{{/if}}</div></div>{{/if}}
{{#if firing}}<div class="round-firing-table"><div class="round-battery-row">{{#each batteries}}<article><small>{{mount}} · {{arc}}° · Range {{range}}</small><b>{{name}}</b><span>{{formula}} · {{status}}</span><button data-round-action="arcs" data-battery-id="{{id}}">Show arc / bands</button><button class="round-primary" data-round-action="fire" data-battery-id="{{id}}" {{#unless @root.canFireNow}}disabled{{/unless}} {{#unless ready}}disabled{{/unless}}>Commit shot · 1 AP</button></article>{{/each}}</div>{{#each orders}}<label class="round-firing-order">{{name}}<select data-round-order="{{id}}"><option value="">Choose legal target…</option>{{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><button data-round-action="hold-order" data-attack-id="{{id}}">Hold shot</button></label>{{/each}}<div class="round-decision-bar"><span>Range: near 0 · medium −2 · far −4</span><button class="round-primary" data-round-action="finish-firing" {{#unless canFinishFiring}}disabled{{/unless}}>Resolve this ship’s firing / hold fire</button></div></div>{{/if}}
{{#if responding}}<div class="round-response-bar"><strong>{{pending.attacker}} → {{pending.defender}}</strong>{{#if canRespond}}<button data-round-action="pass-response">Pass response</button>{{/if}}{{#if canAttack}}<button class="round-primary" data-round-action="attack">Battle Watch · roll to hit</button>{{/if}}</div>{{/if}}
{{#if retargeting}}<div class="round-alert">Firing solution changed. {{#each retargets}}<button data-round-action="retarget" data-target-id="{{id}}" data-ship-id="{{@root.pending.shipId}}">Target {{name}}</button>{{/each}}<button data-round-action="retarget" data-ship-id="{{pending.shipId}}">Hold shot</button></div>{{/if}}
{{#if damageStep}}<div class="round-resolution-wait"><div class="round-resolution-emblem">{{hit.total}}</div><div><small>ATTACK SAVED · d20 {{hit.die}} + {{hit.modifier}} vs AC {{hit.dc}}</small><h2>{{pending.attacker}} → {{pending.defender}}</h2><p>Damage uses the saved hit result. A miss rolls no hit damage.</p><button class="round-primary" data-round-action="damage" {{#unless canDamage}}disabled{{/unless}}>Resolve damage &amp; mitigation</button></div></div>{{/if}}
{{#if recap}}<section class="round-recap"><h2>Round {{s.round}} · Ship’s log</h2>{{#each recapNarrative}}<p class="round-narrative">{{this}}</p>{{/each}}<details><summary>Movement, checks and damage · exact record</summary>{{#each recapLines}}<p>{{text}}</p>{{/each}}</details>{{#if journal}}<button data-round-action="open-journal">Open journal · {{journal.journalId}}</button>{{else}}{{#if gm}}<button data-round-action="retry-recap">Save / retry journal</button>{{/if}}{{/if}}{{#if gm}}{{#unless complete}}<button class="round-primary" data-round-action="round" {{#if unsettled}}disabled{{/if}}>Start next round</button>{{/unless}}{{/if}}</section>{{/if}}
{{#each choices}}<section class="round-alert"><strong>{{name}} · Complication</strong>{{#if allowed}}{{#each options}}<button data-round-action="choose-complication" data-choice-id="{{../id}}" data-ship-id="{{../shipId}}" data-option-id="{{id}}">{{label}}</button>{{/each}}{{/if}}</section>{{/each}}
{{/unless}}
</main>
{{/if}}
</section>
