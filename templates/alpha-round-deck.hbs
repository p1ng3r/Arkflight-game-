<section class="round-shell {{#if panelOnly}}is-portrait{{/if}}" data-round-phase="{{s.phase}}">
{{#if panelOnly}}
<article class="round-art-card theme-{{card.theme}} category-{{card.category}}" style="--alpha-category-accent:{{card.categoryAccent}}">
<header class="round-card-title"><span>{{#if card}}{{card.categoryLabel}} · {{card.band}} · {{card.stationLabel}}{{else}}BATTLE WATCH · FIRING{{/if}}</span><b>{{#if card}}{{card.ap}} AP{{else}}d20{{/if}}</b></header>
<div class="round-art-well">{{#if card}}<img src="{{card.sceneArt}}" alt="{{card.name}} artwork">{{else}}<i class="fa-solid fa-crosshairs" aria-hidden="true"></i>{{/if}}<div><h2>{{#if card}}{{card.name}}{{else}}{{pending.attacker}} · battery attack{{/if}}</h2><small>{{ship.name}}</small></div></div>
<div class="round-card-parchment">
{{#if card}}<p>{{card.text}}</p><details><summary>Four roll outcomes</summary>{{#each card.outcomes}}<section class="round-outcome is-{{theme}}"><b>{{label}}</b><p>{{text}}</p></section>{{/each}}</details>{{/if}}
{{#if receipt}}<div class="round-saved-receipt"><strong>Saved result · {{receipt.total}}</strong><span>d20 {{receipt.die}} + modifier {{receipt.modifier}} vs DC {{receipt.dc}}</span></div>{{/if}}
{{#if planningCards}}
{{#if card.needsBattery}}<label>Battery<select data-alpha-battery>{{#each batteries}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · {{status}}</option>{{/each}}</select></label>{{/if}}
{{#if card.movementCard}}<label>Movement option<select data-alpha-adjustment>{{#each adjustments}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
{{#if card.isBoarding}}<label>Boarding target<select data-alpha-target><option value="">Choose alongside ship</option>{{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
<p class="round-note">Commit now; the station rolls during resolution. Weapon cards include their printed shot. Normal batteries cost 1 AP later.</p>
{{else}}{{#unless receipt}}
<div class="round-crew-identity">{{#if crewPortrait}}<img src="{{crewPortrait}}" alt="{{crewActor}}">{{/if}}<div><strong>{{crewActor}}</strong><small>{{card.stationLabel}}</small></div></div>
<label>Station skill<select data-round-skill><option value="">Choose a skill…</option>{{#each skills}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
{{#if breakdown}}<div class="round-bonus-total">{{breakdown.name}} · {{breakdown.modifierText}} · {{breakdown.dcLabel}} {{breakdown.dc}}</div><dl class="round-breakdown">{{#each breakdown.components}}<dt>{{label}}</dt><dd>{{value}}</dd>{{/each}}</dl>{{/if}}
{{/unless}}{{/if}}
{{#if error}}<p class="round-error" role="alert">{{error}}</p>{{/if}}
</div>
<footer class="round-card-controls">
{{#if canCycle}}<button data-round-action="cycle-card" title="Once per round: discard this card and draw a replacement, without spending AP.">Cycle card · free once per round</button>{{/if}}
{{#if planningCards}}<button class="round-primary" data-round-action="queue-card" {{#unless canQueue}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>Commit · {{card.ap}} AP</button>{{else}}
{{#if requestId}}<button class="round-roll" data-round-action="roll-crew" {{#unless canSubmitRoll}}disabled{{/unless}} {{#if busy}}disabled{{/if}} aria-label="Roll assigned station check"><i class="fa-solid fa-dice-d20"></i><b>d20</b></button>{{else}}
{{#if isOwnResolve}}<button class="round-roll" data-round-action="resolve-card" {{#unless canResolve}}disabled{{/unless}} {{#if busy}}disabled{{/if}} aria-label="Resolve committed card">{{#if card.attackOnly}}Prepare shot{{else}}<i class="fa-solid fa-dice-d20"></i><b>d20</b>{{/if}}</button>{{else}}
{{#if canAttack}}<button class="round-roll" data-round-action="attack" {{#unless canSubmitRoll}}disabled{{/unless}} {{#if busy}}disabled{{/if}}><i class="fa-solid fa-dice-d20"></i><b>d20</b></button>{{else}}{{#if canInstant}}<button class="round-roll" data-round-action="play" {{#if busy}}disabled{{/if}} aria-label="Play Instant and roll"><i class="fa-solid fa-dice-d20"></i><b>d20</b></button>{{else}}<span class="round-note">{{#if receipt}}Resolved once · result saved{{else}}Inspection · wait for an eligible phase{{/if}}</span>{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}
{{#if canSkip}}<button data-round-action="skip-card" title="Discard this card; committed AP stays spent">Skip card</button>{{/if}}<button data-round-action="close-card">Close</button>
</footer></article>
{{else}}
<nav class="hud-panel-controls" aria-label="Show or hide HUD panels"><span class="hud-folded-round">Round {{s.round}} · {{phaseLabel}} · {{ship.ap}} AP</span>{{#each panelButtons}}<button data-round-action="toggle-panel" data-panel="{{id}}" aria-expanded="{{expanded}}" title="{{#if collapsed}}Restore{{else}}Minimize{{/if}} {{label}}">{{#if collapsed}}+{{else}}−{{/if}} {{label}}</button>{{/each}}<button data-round-action="focus-layout" title="Minimize optional panels; pending decisions stay visible">Focus canvas</button><button data-round-action="reset-layout" title="Restore all four panels">Restore all</button></nav>
<button class="hud-visibility" data-round-action="toggle-hud">{{#if hudHidden}}Show Arkflight HUD{{else}}Hide HUD{{/if}}</button>
<nav class="hud-phase-bar" aria-label="Round phases"><div class="hud-brand"><img src="modules/arkflight-game/assets/ui/branding/arkflight_logo_Simple.webp" alt=""><span>ARKFLIGHT<small>ROUND {{s.round}} · CREW COMMAND</small></span></div>{{#each phaseSteps}}<span class="hud-phase-badge {{#if active}}active{{/if}} {{#if done}}done{{/if}}">{{label}}</span>{{/each}}<div class="hud-readiness">{{#each readiness}}<span class="{{#if ready}}ready{{/if}}">{{name}} · {{label}}</span>{{/each}}</div><small class="hud-build-stamp">{{buildId}}</small></nav>
<aside class="hud-ship-panel"><header class="round-command-header">{{#if shipArt}}<button class="hud-ship-portrait" data-round-action="sheet" title="Open {{ship.name}} ship sheet"><img src="{{shipArt}}" alt="{{ship.name}}"></button>{{/if}}<div class="round-ship-name"><small>ARKFLIGHT · CREW COMMAND</small>{{#if ship}}<select data-alpha-ship aria-label="Your ship">{{#each ships}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>{{else}}<h2>Build a test battle</h2>{{/if}}</div><button data-round-action="sheet" class="hud-ship-sheet">Ship Sheet</button><details class="hud-quick-tools"><summary>Ship tools</summary><div><button data-round-action="ship-art">Choose ship art</button><button data-round-action="deck-browser">Browse combat deck</button><button data-round-action="library">Ship setup / loadouts</button><button data-round-action="help" aria-expanded="{{helpOpen}}">{{#if helpOpen}}Hide help{{else}}How to play{{/if}}</button></div></details><div class="round-phase-caption"><b>{{phaseLabel}}</b><small>{{phaseInstruction}}</small></div>{{#if ship}}<div class="round-ap-counter"><b>{{ship.ap}}</b><small>AP</small></div>{{/if}}<button data-alpha-sound>Audio {{#if preferences.sound}}ON{{else}}OFF{{/if}}</button><button data-round-action="minimize" aria-label="Minimize ship panel">−</button><details class="round-settings"><summary aria-label="Command settings">⚙</summary><div><label>Style<select data-alpha-layout><option value="illustrated" {{#if layoutIllustrated}}selected{{/if}}>Illustrated</option><option value="minimalist" {{#if layoutMinimalist}}selected{{/if}}>Minimalist</option></select></label><label>Motion<select data-alpha-motion><option value="full" {{#if soundFull}}selected{{/if}}>Full</option><option value="subtle" {{#if soundSubtle}}selected{{/if}}>Subtle</option><option value="off" {{#if soundOff}}selected{{/if}}>Off</option></select></label><label>Volume<input data-alpha-volume type="range" min="0" max="0.4" step="0.01" value="{{preferences.volume}}"></label>{{#if gm}}<button data-round-action="guided-test">3-round crew test</button><button data-round-action="download-debug">Download debug.txt</button>{{/if}}<button data-round-action="tracker">Phase tracker</button><button data-round-action="crew">Ship / Crew</button><button data-round-action="library">Library / Decks</button>{{#if gm}}<button data-round-action="reset">Reset encounter</button>{{/if}}<button data-round-action="clear-arcs">Clear preview</button></div></details></header>{{#if ship}}<div class="round-ship-status" aria-label="Ship resources">{{#each meters}}<div class="hud-resource meter-{{name}} {{#if warning}}is-warning{{/if}}" title="{{label}} {{value}} / {{max}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i><div class="hud-resource-content"><div class="hud-resource-label"><span>{{label}}</span><b>{{value}} <small>/ {{max}}</small></b></div><div class="hud-resource-gauge" role="meter" aria-label="{{label}}" aria-valuenow="{{value}}" aria-valuemin="0" aria-valuemax="{{max}}">{{#each segments}}<span class="{{#if filled}}is-filled{{/if}}"></span>{{/each}}</div></div></div>{{/each}}</div>{{/if}}
{{#if activeEffects.length}}<details class="hud-effects"><summary>Active &amp; prepared effects · {{activeEffects.length}}</summary>{{#each activeEffects}}<p><b>{{label}}</b> {{amount}} · {{until}}{{#if uses}} · {{uses}} use(s){{/if}}</p>{{/each}}</details>{{/if}}
{{#if error}}<p class="round-error" role="alert">{{error}}</p>{{/if}}
{{#if guidedRunning}}<div class="round-guided-banner"><b>Guided test · Round {{s.round}} / 3 · Step {{guidedTest.step}}</b><button data-round-action="guided-test">Open Next Step controls</button><button data-round-action="download-debug">Download debug.txt</button></div>{{/if}}

<aside class="hud-basic-actions"><b>WEAPONS &amp; SHIP COMMAND</b><button data-round-action="weapons">Fire Weapon · 1 AP</button><button data-round-action="sheet">Open Ship Sheet</button><small>Weapons fire during the Firing phase.</small>{{#if weaponsOpen}}<div>{{#each batteries}}<button data-round-action="arcs" data-battery-id="{{id}}" aria-pressed="{{arcVisible}}">{{name}} · {{#if arcVisible}}Hide arc / range{{else}}Show arc / range{{/if}}</button>{{/each}}</div>{{/if}}</aside></aside><button class="hud-crew-toggle" data-round-action="toggle-crew" aria-expanded="{{crewVisible}}">{{#if crewVisible}}Hide crew{{else}}Show crew{{/if}}</button>{{#if crewVisible}}<nav class="hud-crew-rail" aria-label="Crew character sheets"><strong>CREW · CHARACTER SHEETS</strong>{{#each crewRail}}<button data-round-action="crew-sheet" data-actor-id="{{actorId}}" class="{{#if pending}}is-pending{{/if}}" {{#unless actorId}}disabled{{/unless}} title="Open {{name}} character sheet">{{#if img}}<img src="{{img}}" alt="">{{/if}}<span>{{label}}<small>{{name}}</small></span></button>{{/each}}</nav>{{/if}}
{{#if fleetDial.length}}
<section class="arkflight-mini-fleet" aria-label="Fleet maneuver locks" role="status">
  <header><i class="fa-solid fa-compass" aria-hidden="true"></i><strong>FLEET MANEUVERS</strong></header>
  <div class="arkflight-mini-fleet-ships">
    {{#each fleetDial}}
      <div class="arkflight-mini-ship {{#if ready}}is-locked{{/if}}" title="{{name}} · {{label}}">
        <img src="{{art}}" alt="" aria-hidden="true"><span>{{name}}</span>
        <i class="fa-solid {{#if ready}}fa-lock{{else}}fa-hourglass-half{{/if}}" aria-hidden="true"></i>
      </div>
    {{/each}}
  </div>
  {{#if fleetCountdown}}<div class="arkflight-fleet-clock"><b data-fleet-countdown>5</b><small>All ships locked · moving together</small></div>{{else}}<small>Awaiting fleet lock · enemy routes remain hidden</small>{{/if}}
</section>
{{/if}}
{{#if drawReveal}}
<section class="arkflight-draw-reveal" role="dialog" aria-label="Arkflight crew draw reveal" aria-live="polite">
  <header><small>ARKFLIGHT · SHARED DECK</small><h2>New Cards</h2><p>Each online crew member on this ship may confirm, or the countdown continues automatically.</p></header>
  {{#if revealCards.length}}
    <div class="arkflight-reveal-cards">{{#each revealCards}}
      <article class="arkflight-reveal-card" style="--alpha-category-accent:{{categoryAccent}}">
        <img src="{{sceneArt}}" alt="{{name}} artwork">
        <strong>{{name}}</strong>
        <small>{{categoryLabel}} · {{ap}} AP</small>
        <p>{{text}}</p>
      </article>
    {{/each}}</div>
    <div class="arkflight-reveal-footer">
      <span>Confirmed {{revealReady}} / {{revealRequired}}</span>
      <button class="round-primary" data-round-action="ready-draw" {{#unless revealCanReady}}disabled{{/unless}}>{{#if revealCanReady}}Ready · Send to hand{{else}}Waiting for crew{{/if}}</button>
      <small>Auto-continue in <b data-draw-countdown>12</b>s</small>
    </div>
  {{else}}<p class="arkflight-reveal-wait">Your ship is ready. Other crews are finishing their card reveals.</p>{{/if}}
</section>
{{/if}}
<main class="round-workspace">
{{#if helpOpen}}<section class="hud-help"><h2>{{phaseLabel}}</h2><p>{{phaseInstruction}}</p><ol><li>Opening: keep five cards or replace up to two.</li><li>Maneuver: choose a hull template, then lock. The GM reveals the fleet.</li><li>Plan: commit cards or keep your hand; reserve AP for weapons and Instants.</li><li>Station rolls: open the action card, choose your crew skill, then roll.</li><li>Firing: choose a legal target for each ready weapon, then commit. Respond or pass when prompted.</li><li>Recap: resolve choices, discard overflow and begin the next round.</li></ol><button data-round-action="help">Got it · close help</button></section>{{/if}}
{{#if cardChoice}}<section class="hud-card-choice"><h2>{{#if cardChoice.isSurvey}}Choose a charted card{{else}}Recover a discarded card{{/if}}</h2>{{#each cardChoice.options}}<button data-round-action="choose-card" data-instance-id="{{id}}"><img src="{{art}}" alt="">{{name}}</button>{{/each}}</section>{{/if}}
{{#if crewPanel}}<section class="round-crew-panel"><h2>Ship crew · {{ship.name}}</h2>{{#each stations}}<label>{{name}} · {{actorName}}<small>{{skills}}</small><select data-alpha-assign="{{id}}" {{#unless @root.canAssignCrew}}disabled{{/unless}}><option value="">Ship baseline</option>{{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/each}}</section>{{/if}}
{{#unless roundFlow}}
<section class="round-welcome"><h2>The crew card table</h2>{{#if gm}}<button class="round-primary" data-round-action="guided-test">Create 2 ships + full crews · Guided 3-round test</button>{{/if}}<p>One shared hand. Plan together, roll at your stations, and fight on the canvas.</p>{{#if gm}}{{#if s}}<p>This encounter uses the earlier alpha rules. Reset to start the new flow with saved ships and crew.</p><button class="round-primary" data-round-action="reset">Reset into new round flow</button>{{else}}<div class="round-builder"><label>Crew hull<select data-round-build="hullId">{{#each hulls}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Enemy hull<select data-round-build="enemyHullId">{{#each hulls}}<option value="{{id}}" {{#if enemySelected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Level<input data-round-build="level" type="number" min="1" max="20" value="{{build.level}}"></label><label>Fleet<select data-round-build="count"><option value="2">2 ships</option><option value="4" {{#if buildFour}}selected{{/if}}>4 ships</option></select></label></div><button class="round-primary" data-round-action="start">Build test fleet</button>{{/if}}{{else}}<p>Waiting for the GM to start the battle.</p>{{/if}}</section>
{{else}}
{{#if pendingDiscard}}<div class="round-alert">Cleanup · select {{pendingDiscard}} card(s). {{selectionCount}} selected.<button data-round-action="discard" {{#unless canDiscard}}disabled{{/unless}}>Discard selected</button></div>{{/if}}
{{#if showHand}}<div class="round-hand-table"><aside class="round-deck-stack"><button class="round-draw-deck {{#if canDraw}}is-ready{{/if}}" data-round-action="draw-round" data-alpha-pile="draw" {{#unless canDraw}}disabled{{/unless}} {{#if busy}}disabled{{/if}} aria-label="Draw this round’s card"><span class="hud-deck-compass" aria-hidden="true"></span><b>{{drawCount}}</b><small>{{#if canDraw}}DRAW{{else}}DECK{{/if}}</small></button><div class="round-hand-limit">{{ship.hand.length}} / {{ship.profile.hand}} hand{{#if handOverflow}}<strong>Discard {{handOverflow}} at Cleanup</strong>{{/if}}</div><button data-round-action="deck-browser" class="hud-browse-piles">Browse piles</button><details class="round-discard-pile"><summary><img class="hud-discard-art" src="modules/arkflight-game/assets/ui/canvas-hud/discard-pile.webp" alt="" loading="lazy">Discard · {{ship.discard.length}}</summary>{{#each discardCards}}<p>{{name}}</p>{{else}}<p>Empty</p>{{/each}}<small>Burned {{ship.burned.length}} · Prepared {{ship.prepared.length}}</small></details></aside><div class="hud-ap-medallion" aria-label="{{ship.ap}} Action Points available"><small>AP</small><b>{{ship.ap}}</b></div>
<div class="alpha-hand round-hand" aria-label="Shared crew hand">{{#each hand}}<button class="round-hand-card theme-{{theme}} category-{{category}} {{#if selected}}is-selected{{/if}} {{#if queued}}is-queued{{/if}} {{#if respondable}}is-respondable{{/if}}" data-alpha-card="{{instanceId}}" style="--card-tilt:{{tilt}}deg;--alpha-category-accent:{{categoryAccent}}" aria-pressed="{{selected}}" aria-label="{{name}} · {{ap}} AP{{#if respondable}} · Instant ready, click to respond{{/if}}" title="{{name}} · {{ap}} AP"><span class="round-hand-band" title="{{#if burn}}Removed from the encounter when used{{else}}{{#if delayed}}Schedules a later effect{{else}}{{#if isInstant}}Playable in its response window; costs AP{{else}}Commit during card planning{{/if}}{{/if}}{{/if}}">{{band}}</span><span class="round-hand-category" title="Card category">{{categoryLabel}}</span><b class="round-hand-cost">{{ap}}</b><div class="hud-card-illustration"><img class="hud-card-scene" src="{{sceneArt}}" alt=""><img class="hud-card-emblem" src="{{art}}" alt=""></div><strong>{{name}}</strong><small>{{stationLabel}}</small><p class="hud-card-rules">{{text}}</p><span class="round-hand-state">{{#if queued}}COMMITTED{{else}}{{#if respondable}}⚡ RESPOND{{else}}{{#if selected}}RETURN / DISCARD{{else}}{{categoryLabel}}{{/if}}{{/if}}{{/if}}</span></button>{{else}}<div class="round-empty-hand">No cards in hand. Ready weapons can still fire for AP.</div>{{/each}}</div></div>{{/if}}
{{#if opening}}<div class="round-decision-bar">{{#if canMulligan}}<span>Return up to 2 · {{selectionCount}} selected</span><button class="round-primary" data-round-action="mulligan" {{#unless canConfirmMulligan}}disabled{{/unless}}>Keep / replace selected</button>{{else}}<span>Opening hand kept · waiting for the other ships.</span>{{/if}}</div>{{/if}}
{{#if planningCards}}<details class="round-weapon-preview"><summary>Inspect weapon arcs / range bands · no AP cost</summary><div>{{#each batteries}}<button data-round-action="arcs" data-battery-id="{{id}}" aria-pressed="{{arcVisible}}">{{name}} · {{range}} hex</button>{{/each}}<small>Green 1–2: 0 · Amber 3–4: −2 · Red 5+: −4 accuracy</small></div></details><section class="round-planning-tray"><div><b>{{#if followup}}Newly drawn cards · add orders or keep{{else}}Orders · {{committedAP}} AP committed{{/if}}</b><small>Resolve in this order. Keep AP for firing and Instants.</small></div><ol>{{#each cardPlans}}<li><span>{{index}}</span><b>{{name}}</b><small>{{cost}} AP</small>{{#if canRemove}}<button data-round-action="move-card" data-instance-id="{{instanceId}}" data-direction="-1" {{#if first}}disabled{{/if}} aria-label="Move {{name}} earlier">←</button><button data-round-action="move-card" data-instance-id="{{instanceId}}" data-direction="1" {{#if last}}disabled{{/if}} aria-label="Move {{name}} later">→</button><button data-round-action="unqueue-card" data-instance-id="{{instanceId}}" aria-label="Remove {{name}}">×</button>{{/if}}</li>{{else}}<li class="round-empty-plan">No cards committed. You may keep your hand.</li>{{/each}}</ol>{{#if planLocked}}<b>Plan locked · waiting</b>{{else}}<button class="round-primary" data-round-action="lock-cards" {{#unless canLockCards}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>Lock plan / keep remaining cards</button>{{/if}}</section>{{/if}}
{{#if maneuverStep}}<div class="round-maneuver-table"><h2>{{ship.name}} · Maneuvers</h2><p>{{routes.length}} available hull templates · choose, preview, lock</p>{{#if canPlan}}<div class="round-maneuver-strip">{{#each routes}}<button data-round-action="route" data-ship-id="{{@root.ship.id}}" data-route="{{id}}" class="{{#if selected}}is-selected{{/if}}" {{#if @root.locked}}disabled{{/if}}><span>{{{svg}}}</span><b>{{name}}</b><small>{{ap}} AP</small></button>{{/each}}</div>{{/if}}<div class="round-decision-bar"><span>{{#if locked}}Course locked{{else}}{{#if route}}{{route.name}} · {{route.description}}{{else}}Choose a template for this ship this round.{{/if}}{{/if}}</span>{{#if canPlan}}<button data-round-action="plan" data-ship-id="{{ship.id}}" {{#if locked}}disabled{{/if}}>Stage</button>{{/if}}<button class="round-primary" data-round-action="lock" data-ship-id="{{ship.id}}" {{#unless canLock}}disabled{{/unless}} {{#if locked}}disabled{{/if}}>Lock maneuver</button>{{#if primary}}{{#if allLocked}}<button data-round-action="confirm-move">Reveal &amp; move fleet</button>{{/if}}{{/if}}</div></div>{{/if}}
{{#if resolvingCards}}<div class="round-resolution-wait"><div class="round-resolution-emblem">✦</div><div><small>STATION RESOLUTION</small><h2>{{currentCardName}}</h2><p>{{phaseInstruction}}</p><button class="round-primary" data-round-action="inspect-current" {{#unless canInspectCurrent}}disabled{{/unless}}>Open station card / Roll</button>{{#if crewRequest.canCancel}}<button data-round-action="cancel-crew">Cancel request</button>{{/if}}</div></div>{{/if}}
{{#if firing}}<div class="round-firing-table"><h2 class="round-firing-heading">{{ship.name}} · Weapons</h2><div class="round-firing-scroll"><div class="round-battery-row">{{#each batteries}}<article><small>{{mount}} · {{arc}}° · Range {{range}}</small><b>{{name}}</b><span>{{formula}} · {{status}}</span>{{#unless hasLegalTarget}}<small>No target in this arc / range</small>{{/unless}}<button data-round-action="arcs" data-battery-id="{{id}}" aria-pressed="{{arcVisible}}">{{#if arcVisible}}Hide arc / bands{{else}}Show arc / bands{{/if}}</button>{{#if hasLegalTarget}}<button data-round-action="aim-canvas" data-battery-id="{{id}}">Aim on canvas · dotted target lines</button>{{/if}}{{#if target}}<p class="hud-firing-solution">{{target.name}} · {{target.distance}} hex · {{target.penalty}} range<br>Base damage {{formula}}. {{#if @root.gunnery}}Crew preview {{@root.gunnery.modifierText}} ({{@root.gunnery.skill}}), before range and active effects. {{/if}}Active card effects apply at resolution; Battle Watch chooses its crew skill before rolling.</p>{{else}}{{#if hasLegalTarget}}<small>Click Aim on canvas, then a target marker.</small>{{/if}}{{/if}}<button class="round-primary" data-round-action="fire" data-battery-id="{{id}}" data-target-id="{{target.id}}" {{#unless canCommit}}disabled{{/unless}}>Commit shot · 1 AP</button></article>{{/each}}</div>{{#each orders}}<label class="round-firing-order">{{name}}<span>Target: {{targetName}}</span><button data-round-action="aim-order-canvas" data-attack-id="{{id}}">Choose / change target on canvas</button><button data-round-action="hold-order" data-attack-id="{{id}}">Hold shot</button></label>{{/each}}</div><div class="round-decision-bar"><span>Lines: port violet · starboard gold · fore cyan · aft rose</span><small>Range: near 0 · medium −2 · far −4</small><button class="round-primary" data-round-action="finish-firing" {{#unless canFinishFiring}}disabled{{/unless}}>Hold fire / Finish firing</button></div></div>{{/if}}
{{#if responding}}<section class="round-response-bar" role="region" aria-label="Pending attack and Instant responses"><small>INCOMING FIRE · AP PAYS FOR INSTANTS</small><h2>{{responseSummary.attacker}} → {{responseSummary.target}}</h2><p>{{responseSummary.weapon}} · Base damage {{responseSummary.formula}}</p>{{#if canRespond}}{{#if eligibleInstants.length}}<p role="status">Your glowing, raised Instants are ready. Click one in your hand to respond. Opening it does not spend AP.</p>{{else}}<p>No usable Instant is available to your station. You may pass.</p>{{/if}}<button data-round-action="pass-response">Pass · keep cards and AP</button>{{else}}<p>{{#if responseSummary.passed}}Response complete. Battle Watch may roll the attack.{{else}}Waiting for the defending crew’s response.{{/if}}</p>{{/if}}{{#if canAttack}}<button class="round-primary" data-round-action="inspect-attack">Battle Watch · choose skill / roll</button>{{/if}}</section>{{/if}}
{{#if retargeting}}<div class="round-alert">Firing solution changed. {{#each retargets}}<button data-round-action="retarget" data-target-id="{{id}}" data-ship-id="{{@root.pending.shipId}}">Target {{name}}</button>{{/each}}<button data-round-action="retarget" data-ship-id="{{pending.shipId}}">Hold shot</button></div>{{/if}}
{{#if damageStep}}<div class="round-resolution-wait"><div class="round-resolution-emblem">{{hit.total}}</div><div><small>ATTACK SAVED · d20 {{hit.die}} + {{hit.modifier}} vs AC {{hit.dc}}</small><h2>{{pending.attacker}} → {{pending.defender}}</h2><p>Damage uses the saved hit result. A miss rolls no hit damage.</p><button class="round-primary" data-round-action="damage" {{#unless canDamage}}disabled{{/unless}}>Resolve damage &amp; mitigation</button></div></div>{{/if}}
{{#if recap}}<section class="round-recap"><h2>Round {{s.round}} · Ship’s log</h2>{{#each recapNarrative}}<p class="round-narrative">{{this}}</p>{{/each}}<details><summary>Recent exchanges · checks &amp; damage</summary>{{#each results}}<article class="hud-recap-exchange"><b>{{shipName}}{{#if targetName}} → {{targetName}}{{/if}}</b><p>{{#if check}}{{station}} · {{label}} · d20 {{die}} + {{modifier}} = {{total}} vs {{dc}}{{else}}{{raw}} raw · {{damage}} Hull damage{{/if}}</p></article>{{/each}}</details><details><summary>Movement, checks and damage · exact record</summary>{{#each recapLines}}<p>{{text}}</p>{{/each}}</details>{{#if journal}}<button data-round-action="open-journal">Open journal · {{journal.journalId}}</button>{{else}}{{#if gm}}<button data-round-action="retry-recap">Save / retry journal</button>{{/if}}{{/if}}{{#if gm}}{{#unless complete}}<button class="round-primary" data-round-action="round" {{#if unsettled}}disabled{{/if}}>Start next round</button>{{/unless}}{{/if}}</section>{{/if}}
{{#if choices.length}}<button class="hud-complication-reminder" data-round-action="open-complications">Resolve pending Complication · click to open</button>{{/if}}

{{/unless}}
</main>
{{/if}}
</section>
