<section class="cc-canvas-shell">
<header class="cc-round-ribbon"><div><span class="card-eyebrow">Arkflight · Crew Command</span><strong>Round {{state.round}} · {{phaseLabel}}</strong><small>{{phaseHint}}</small></div><label class="cc-motion-control">Motion <select data-cc-motion aria-label="Combat motion"><option value="full">Full</option><option value="subtle">Subtle</option><option value="off">Off</option></select></label><button type="button" data-cc-sound aria-pressed="false">Sound off</button><button type="button" data-hud-action="toggle-hand">{{#if handCollapsed}}Show Hand{{else}}Fold Hand{{/if}}</button><button type="button" data-hud-action="close" aria-label="Hide crew HUD">×</button></header>
{{#unless sceneMatches}}<div class="cc-scene-alert">View the bound scene to use tokens and weapon overlays. <button type="button" data-hud-action="view-scene">View Encounter Scene</button></div>{{/unless}}
<aside class="cc-vessel-panel cc-ship-dashboard" aria-label="Ship dashboard">
<header class="cc-dashboard-header">
<button type="button" data-dashboard-drag class="cc-dashboard-grip" aria-label="Move ship dashboard" title="Drag to move. Arrow keys move 10 pixels; Shift moves 40. Home resets."><i class="fa-solid fa-grip-vertical" aria-hidden="true"></i></button>
<span class="card-eyebrow">Ship · B {{b}}</span>
<select aria-label="Viewing ship" data-ship-picker>{{#each ships}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}{{#if current}} · ACTIVE{{/if}}</option>{{/each}}</select>
<span class="cc-dashboard-mini">Hull {{resources.hull.value}} · Veil {{resources.lifeveil.value}} · AP {{ap.remaining}} · RP {{rp}}</span>
<button type="button" data-dashboard-collapse aria-expanded="true" aria-controls="cc-dashboard-body">Collapse</button>
<button type="button" data-dashboard-reset title="Restore the dashboard above your cards">Reset</button>
<button type="button" data-hud-action="focus-token">Find Token</button>
</header>
<div class="cc-vessel-body" id="cc-dashboard-body" data-dashboard-expanded>
<div class="cc-dashboard-points"><div class="card-point-pool"><div data-cc-pool="ap"><img class="cc-pool-crystal" src="modules/arkflight-game/assets/ui/card-combat/animation-art/ap-crystal.webp" alt=""><strong>{{ap.remaining}}</strong><span>AP uncommitted</span></div><div data-cc-pool="rp"><img class="cc-pool-crystal" src="modules/arkflight-game/assets/ui/card-combat/animation-art/rp-crystal.webp" alt=""><strong>{{rp}}</strong><span>Shared RP</span></div></div>{{#if ap.bonusAvailable}}<small class="card-earned-ap">+{{ap.bonusAvailable}} earned AP</small>{{/if}}</div>
<div class="card-resource-meters">{{#each meters}}<div class="card-resource resource-{{id}} {{#if warning}}is-warning{{/if}}"><label>{{name}}<span>{{value}} / {{max}}</span></label><div class="card-resource-track"><i style="width:{{percent}}%"></i></div></div>{{/each}}</div>
<div class="cc-helm"><p>Move <b>{{motion.used}} / {{motion.allowance}}</b> · Turns <b>{{motion.turns}} / {{motion.turnAllowance}}</b></p><div class="card-helm"><button type="button" data-card-command="helm" data-direction="left" {{#unless canMove}}disabled{{/unless}}>↶ 60°</button><button type="button" data-card-command="helm" data-direction="forward" {{#unless canMove}}disabled{{/unless}}>↑ Hex</button><button type="button" data-card-command="helm" data-direction="right" {{#unless canMove}}disabled{{/unless}}>60° ↷</button></div></div>
</div>
<details class="cc-dashboard-tools" data-dashboard-expanded><summary>Weapon arcs & ship controls</summary><div class="cc-dashboard-tool-body">
<div class="cc-coverage"><h3>Weapon arcs & range</h3><select data-overlay-weapon aria-label="Weapon coverage"><option value="">All weapons</option>{{#each weaponChoices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><button type="button" data-hud-action="arcs" aria-pressed="{{#if arcsVisible}}true{{else}}false{{/if}}">{{#if arcsVisible}}Hide{{else}}Show{{/if}} Firing Coverage</button><small>Fore cyan · Port violet · Starboard gold · Aft coral. Dim coverage means reloading.</small></div>
<p class="cc-dashboard-help">Drag the ship forward on the canvas. Use the helm to change course.</p>
{{#if isGM}}<button type="button" class="cc-end-encounter" data-card-command="end">End Encounter</button>{{/if}}{{#if complete}}<button type="button" data-hud-action="setup">Prepare Another Encounter</button>{{/if}}
</div></details>
</aside>
<section class="cc-orders-panel"><header><h2>Committed orders</h2><span>{{pendingCount}} pending</span><button type="button" data-card-command="advance" {{#unless canEnd}}disabled{{/unless}}>Finish Ship Turn →</button></header>{{#if lastOutcome}}<div class="cc-last-outcome" role="status"><strong>R{{lastOutcome.round}} · {{lastOutcome.name}} · {{lastOutcome.label}}</strong><span>d20 {{lastOutcome.die}} · Total {{lastOutcome.total}}</span>{{#if lastOutcome.text}}<small title="{{lastOutcome.text}}">{{lastOutcome.text}}</small>{{/if}}</div>{{/if}}<div class="cc-order-chips">{{#each orders}}<button type="button" data-preview-order="{{id}}" data-drag-order="{{id}}" draggable="{{#if canResolve}}true{{else}}false{{/if}}" class="order-{{status}}"><img src="{{art}}" alt="" draggable="false"><span>{{name}}<small>{{operatorName}} · {{status}}</small></span></button>{{else}}<p>Choose cards and basic orders below, then lock the Captain's plan.</p>{{/each}}</div></section>
{{#if response}}<section class="cc-response-panel">          {{#if response}}
      <section class="card-reaction-prompt"><h3>{{response.name}} — incoming attack {{response.total}}</h3><p>Rolled battery damage: {{response.damage}} before critical result and defenses. Defending crew: choose a reaction or pass.{{#if response.remainingTargets}} {{response.remainingTargets}} more target(s) await a response to this volley.{{/if}}</p>
        {{#if response.canRespond}}
          <select data-response-card><option value="">Pass — take the attack</option>{{#each response.cards}}<option value="{{id}}" {{#unless enabled}}disabled{{/unless}}>{{name}}{{#unless enabled}} · unavailable{{/unless}}</option>{{/each}}</select>
          <select data-response-station>{{#each response.stations}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
          <select data-response-skill>{{#each response.skills}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
          <button type="button" data-card-command="respond">Resolve Response</button>
        {{else}}<p>Waiting for the defending crew or GM.</p>{{/if}}
      </section>
    {{/if}}

</section>{{/if}}
{{#if preview}}<aside class="cc-card-preview card-{{preview.type}}" role="region" aria-label="Expanded card"><header><span>{{preview.typeLabel}}</span><button type="button" data-hud-action="close-preview" aria-label="Close card preview">×</button></header><div class="cc-preview-content"><img class="cc-preview-art" src="{{preview.art}}" alt=""><h2>{{preview.name}}</h2><p>{{preview.description}}</p>{{#if preview.outcomes}}<dl class="cc-outcomes" data-outcome-card="{{preview.id}}"><dt data-degree="2">Critical success</dt><dd>{{preview.outcomes.criticalSuccess}}</dd><dt data-degree="1">Success</dt><dd>{{preview.outcomes.success}}</dd><dt data-degree="0">Failure</dt><dd>{{preview.outcomes.failure}}</dd><dt data-degree="-1">Critical failure</dt><dd>{{preview.outcomes.criticalFailure}}</dd></dl>{{/if}}
{{#if canAddPreview}}<button type="button" data-hud-action="add-plan">Add / Remove From Plan</button>{{/if}}{{#if canChoosePreviewReaction}}<button type="button" data-hud-action="choose-reaction">Choose This Reaction</button>{{/if}}
<div class="card-committed-orders">{{#each focusedOrders}}<article data-order-row="{{id}}" class="order-{{status}}"><header><img class="card-order-art" src="{{art}}" alt=""><strong>{{name}}</strong><span>{{operatorName}} · {{status}}{{#if requested}} · Captain requested execution{{/if}}</span></header>
      <div class="card-order-controls"><select data-skill>{{#each skills}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
        {{#if needsChoice}}<select data-choice {{#if multiRoute}}multiple{{/if}}>{{#each choices}}<option value="{{id}}">{{name}}</option>{{/each}}</select>{{/if}}
        {{#if fire}}<select data-target aria-label="Concentrated fire target">{{#each ../targets}}<option value="{{id}}">{{name}}</option>{{/each}}</select><select data-battery aria-label="Weapon mounting side">{{#each ../batteries}}<option value="{{id}}">{{name}}</option>{{/each}}</select><select data-fire-mode aria-label="Fire mode"><option value="concentrate">Concentrate fire</option><option value="split">Split broadside</option></select><fieldset class="cc-fire-weapons" data-fire-weapons><legend>Weapons and targets</legend></fieldset>{{/if}}
        <button data-card-command="resolve" {{#unless canResolve}}disabled{{/unless}}>Roll / Execute</button>
        {{#if canManage}}<button data-card-command="request">Request Player Roll</button><button data-card-command="skip">Skip</button><select data-replacement>{{#each ../crew}}<option value="{{id}}">{{name}}</option>{{/each}}</select><button data-card-command="reassign">Reassign</button>{{/if}}
      </div>{{#if reason}}<p>{{reason}}</p>{{/if}}</article>{{/each}}</div>
{{#if focusedOrders}}<button type="button" data-hud-action="use-target">Use Foundry Target</button><p class="card-panel-hint">Click or drop selects the order and target. Roll / Execute spends it once.</p>{{/if}}</div></aside>{{/if}}
<section class="cc-hand-dock {{#if handCollapsed}}is-collapsed{{/if}}"><header><div class="cc-hand-tabs"><button type="button" data-station-filter="all" aria-pressed="true">Actions</button><button type="button" data-station-filter="reactions" aria-pressed="false">Reactions · {{rp}} RP</button></div><button type="button" data-hud-action="basic-orders">Basic Orders</button><strong data-hand-title>Crew hand</strong><select data-hand-station aria-label="Station filter"><option value="all">All stations</option><option value="mine">My stations</option>{{#each stations}}<option value="{{id}}">{{name}}</option>{{/each}}</select><small>B = Ship Bonus {{b}}</small></header>
<div class="card-hand-scroll"><div data-hand-panel="ap"><div class="cc-card-lane">{{#each cards}}<article class="combat-ability-card cc-playing-card card-{{type}} {{#if cooldown.remaining}}cc-cooling{{/if}} {{#if cooldown.spent}}cc-spent{{/if}}" data-card-filter="{{filter}}" data-preview-card="{{id}}" data-drag-order="{{dragOrderId}}" draggable="{{#if dragOrderId}}true{{else}}false{{/if}}" tabindex="0" role="button" aria-label="Inspect {{name}}"><div class="cc-card-band"><b>{{typeLabel}}</b><span>1 AP</span></div><div class="cc-card-frame" aria-hidden="true"></div>{{#if cooldown.remaining}}<div class="cc-flux-timer" role="progressbar" aria-label="Rounds until ready" aria-valuenow="{{cooldown.remaining}}" aria-valuemin="0" aria-valuemax="{{cooldownRounds}}"><i style="width:{{cooldown.progress}}%"></i><span>Ready R{{cooldown.readyRound}} · {{cooldown.remaining}} rounds</span></div>{{/if}}<div class="cc-card-illustration"><img src="{{art}}" alt="" draggable="false" loading="lazy"></div><div class="cc-card-caption"><strong>{{name}}</strong><small>{{stationLabel}} · {{status}}</small><p>{{description}}</p><label><input type="checkbox" data-plan-card value="{{id}}" {{#unless enabled}}disabled{{/unless}}> Select for plan</label></div></article>{{/each}}
<section class="cc-basic-orders"><h3>Basic orders · 1 AP each</h3>{{#each basics}}<label>{{name}}<input aria-label="{{name}} order count" type="number" data-plan-basic="{{id}}" min="0" max="{{max}}" value="0" {{#unless ../canPlan}}disabled{{/unless}}></label>{{/each}}</section></div></div>
<div data-hand-panel="rp" hidden><div class="cc-card-lane">{{#each reactions}}<article class="combat-ability-card cc-playing-card card-{{type}} {{#if cooldown.remaining}}cc-cooling{{/if}} {{#if cooldown.spent}}cc-spent{{/if}}" data-preview-card="{{id}}" data-drag-reaction="{{id}}" draggable="{{#if canDragReaction}}true{{else}}false{{/if}}" tabindex="0" role="button" aria-label="Inspect {{name}}"><div class="cc-card-band"><b>{{typeLabel}}</b><span>1 RP</span></div><div class="cc-card-frame" aria-hidden="true"></div>{{#if cooldown.remaining}}<div class="cc-flux-timer" role="progressbar" aria-label="Rounds until ready" aria-valuenow="{{cooldown.remaining}}" aria-valuemin="0" aria-valuemax="{{cooldownRounds}}"><i style="width:{{cooldown.progress}}%"></i><span>Ready R{{cooldown.readyRound}} · {{cooldown.remaining}} rounds</span></div>{{/if}}<div class="cc-card-illustration"><img src="{{art}}" alt="" draggable="false" loading="lazy"></div><div class="cc-card-caption"><strong>{{name}}</strong><small>{{status}}</small><p>{{description}}</p></div></article>{{/each}}</div></div></div>
<footer class="card-plan-footer" data-plan-footer><button type="button" class="card-primary card-lock-button" data-card-command="lock" {{#unless canPlan}}disabled{{/unless}}>{{#if bonus}}Lock Additional Orders{{else}}Lock Captain's Plan{{/if}}</button><strong data-plan-budget>0 / {{budget}} AP selected</strong><small>Shared hand · Click to inspect · Drag a committed order onto a ship token</small><span class="cc-lock-mechanism" aria-hidden="true"><i class="cc-lock-bolt"></i><i class="cc-lock-housing"></i></span></footer><footer class="card-plan-footer" data-reaction-footer hidden><strong>{{rp}} shared RP</strong><small>Inspect a reaction, then choose it in the incoming-fire prompt. One separate ship pool.</small></footer></section>
</section>
