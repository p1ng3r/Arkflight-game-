<section class="card-combat-shell">
  <header class="card-command-banner"><div><span class="card-eyebrow">Arkflight · Crew Command</span><h1>{{#if empty}}Take the helm{{else}}{{shipName}}{{/if}}</h1><p>{{#if empty}}Your crew. Your cards. One ship.{{else}}Round {{state.round}} · {{phaseLabel}}{{/if}}</p></div><span class="card-playtest-badge">Combat playtest</span></header>
  {{#if empty}}<section class="card-launch-panel"><h2>Assemble the fleet</h2><p>Select two or more vessels and assign opposing sides. Fitted weapons, upgrades and assigned crew are carried into the test.</p>{{#if isGM}}<div class="card-start-ships">{{#each selectable}}<label><input type="checkbox" data-start-ship value="{{id}}"> <span>{{name}}</span><span class="card-side-label">Side</span><input aria-label="Side for {{name}}" data-start-team value="{{team}}" maxlength="20"></label>{{else}}<p>No Arkflight ships found. Create ship Actors first.</p>{{/each}}</div><button type="button" class="card-primary" data-card-command="start">Launch Encounter</button>{{else}}<p>The GM selects vessels to begin. This board updates when the encounter launches.</p>{{/if}}</section>
  {{else}}
  <div class="card-combat-toolbar"><div><strong>{{phaseLabel}}</strong><span>{{phaseHint}}</span></div><label class="card-ship-select">Viewing <select aria-label="Viewing ship" data-ship-picker>{{#each ships}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · Side {{team}}{{#if current}} · ACTIVE{{/if}}</option>{{/each}}</select></label>{{#if isGM}}<button type="button" data-card-command="end" {{#if complete}}disabled{{/if}}>End Encounter</button>{{/if}}</div>
  <div class="card-command-layout">
    <aside class="card-command-rail"><section><h2>Ship systems <span>B {{b}}</span></h2><div class="card-point-pool"><div><strong>{{ap.remaining}}</strong><span>AP uncommitted</span></div><div><strong>{{rp}}</strong><span>Shared RP</span></div></div>{{#if ap.bonusAvailable}}<p class="card-earned-ap">+{{ap.bonusAvailable}} earned AP available</p>{{/if}}<div class="card-resource-meters">{{#each meters}}<div class="card-resource resource-{{id}} {{#if warning}}is-warning{{/if}}"><label>{{name}} <span>{{value}} / {{max}}</span></label><div class="card-resource-track" role="meter" aria-label="{{name}}" aria-valuenow="{{value}}" aria-valuemin="0" aria-valuemax="{{max}}"><i style="width:{{percent}}%"></i></div></div>{{/each}}</div></section>
      <nav class="card-station-filters" aria-label="Filter card hand"><h2>Stations</h2><button type="button" data-station-filter="all" aria-pressed="true"><i class="fa-solid fa-layer-group"></i><span>All stations</span></button>{{#each stations}}<button type="button" data-station-filter="{{id}}" aria-pressed="false"><img src="{{art}}" alt=""><span>{{name}}<small>{{operator}}</small></span><b>{{count}}</b></button>{{/each}}<button type="button" data-station-filter="reactions" aria-pressed="false"><i class="fa-solid fa-shield-halved"></i><span>Shared reactions</span></button></nav>
      <section class="card-combat-fleet"><h2>Fleet</h2>{{#each ships}}<button type="button" data-view-ship="{{id}}" class="{{#if current}}is-active{{/if}} {{#if selected}}is-selected{{/if}}"><strong>{{name}}</strong><small>Side {{team}} · {{hull}} / {{hullMax}} Hull{{#if current}} · Active{{/if}}{{#if planning}} · Planning{{/if}}</small></button>{{/each}}</section>
    </aside>
    <main class="card-command-deck">
          {{#if response}}
      <section class="card-reaction-prompt"><h3>{{response.name}} — incoming attack {{response.total}}</h3><p>Rolled battery damage: {{response.damage}} before critical result and defenses. Defending crew: choose a reaction or pass.</p>
        {{#if response.canRespond}}
          <select data-response-card><option value="">Pass — take the attack</option>{{#each response.cards}}<option value="{{id}}" {{#unless enabled}}disabled{{/unless}}>{{name}}{{#unless enabled}} · unavailable{{/unless}}</option>{{/each}}</select>
          <select data-response-station>{{#each response.stations}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
          <select data-response-skill>{{#each response.skills}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
          <button type="button" data-card-command="respond">Resolve Response</button>
        {{else}}<p>Waiting for the defending crew or GM.</p>{{/if}}
      </section>
    {{/if}}

      <section class="card-chart-panel"><header><h2>Tactical chart</h2><span>6 headings · 1 vessel / hex</span></header>    <svg class="card-combat-map" viewBox="{{viewBox}}" role="img" aria-label="Card combat hex positions">
      <defs><pattern id="card-hex-grid" width="90" height="51.962" patternUnits="userSpaceOnUse"><path d="M0 0 L15 25.981 L45 25.981 L60 0 M45 25.981 L60 51.962 L90 51.962 M15 25.981 L0 51.962" fill="none" stroke="#3a5262" stroke-width="0.8"/></pattern></defs>
      <rect x="-3000" y="-3000" width="6000" height="6000" fill="url(#card-hex-grid)"/>
      {{#each ships}}<g transform="translate({{x}} {{y}})"><circle r="17" class="{{#if current}}is-active{{/if}}"/><path d="M0 -15 L8 9 L0 5 L-8 9 Z" transform="rotate({{rotation}})"/><text x="22" y="4">{{name}} ({{team}})</text></g>{{/each}}
    </svg>
<div class="card-motion-readout"><span>Moved <strong>{{motion.used}} / {{motion.allowance}}</strong> hexes</span><span>Turns <strong>{{motion.turns}} / {{motion.turnAllowance}}</strong></span></div><div class="card-helm"><button type="button" data-card-command="helm" data-direction="left" {{#unless canMove}}disabled{{/unless}}>↶ 60°</button><button type="button" data-card-command="helm" data-direction="forward" {{#unless canMove}}disabled{{/unless}}>Move 1 Hex ↑</button><button type="button" data-card-command="helm" data-direction="right" {{#unless canMove}}disabled{{/unless}}>60° ↷</button></div></section>
      <section class="card-orders-panel"><header><h2>Committed orders</h2><span>{{pendingCount}} pending</span></header><p class="card-panel-hint">Resolve in any order. Choose targets and batteries when firing.</p>    <div class="card-committed-orders">{{#each orders}}<article data-order-row="{{id}}" class="order-{{status}}"><header><img class="card-order-art" src="{{art}}" alt=""><strong>{{name}}</strong><span>{{operatorName}} · {{status}}{{#if requested}} · Captain requested execution{{/if}}</span></header>
      <div class="card-order-controls"><select data-skill>{{#each skills}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
        {{#if needsChoice}}<select data-choice {{#if multiRoute}}multiple{{/if}}>{{#each choices}}<option value="{{id}}">{{name}}</option>{{/each}}</select>{{/if}}
        {{#if fire}}<select data-target>{{#each ../targets}}<option value="{{id}}">{{name}}</option>{{/each}}</select><select data-battery>{{#each ../batteries}}<option value="{{id}}">{{name}}</option>{{/each}}</select>{{/if}}
        <button data-card-command="resolve" {{#unless canResolve}}disabled{{/unless}}>Roll / Execute</button>
        {{#if canManage}}<button data-card-command="request">Request Player Roll</button><button data-card-command="skip">Skip</button><select data-replacement>{{#each ../crew}}<option value="{{id}}">{{name}}</option>{{/each}}</select><button data-card-command="reassign">Reassign</button>{{/if}}
      </div>{{#if reason}}<p>{{reason}}</p>{{/if}}</article>{{else}}<p>No committed orders yet. All Captains must lock plans before initiative is rolled automatically.</p>{{/each}}</div>
<button type="button" class="card-finish-button" data-card-command="advance" {{#unless canEnd}}disabled{{/unless}}>Finish Ship Turn →</button></section>
          <details class="card-combat-log"><summary>Encounter log</summary>{{#each log}}<p><strong>R{{round}} {{name}} — {{label}}</strong> {{text}}</p>{{/each}}</details>

      {{#if complete}}<section class="card-complete-panel"><h2>Encounter complete {{#if state.winner}}· {{state.winner}}{{/if}}</h2>{{#if isGM}}<details><summary>Prepare another encounter</summary><div class="card-start-ships">{{#each selectable}}<label><input type="checkbox" data-start-ship value="{{id}}"> <span>{{name}}</span><span class="card-side-label">Side</span><input aria-label="Side for {{name}}" data-start-team value="{{team}}" maxlength="20"></label>{{else}}<p>No Arkflight ships found. Create ship Actors first.</p>{{/each}}</div><button type="button" class="card-primary" data-card-command="start">Launch Encounter</button></details>{{/if}}</section>{{/if}}
    </main>
    <aside class="card-hand-panel"><header><h2 data-hand-title>Crew hand</h2><span>Equipped cards</span></header><div class="card-hand-scroll"><div data-hand-panel="ap"><p class="card-panel-hint">Select cards for the plan. Each costs 1 AP. <b>B = Ship Bonus ({{b}}).</b></p><div class="card-combat-hand">{{#each cards}}<article class="combat-ability-card card-{{type}}" data-card-filter="{{filter}}">
  <div class="card-art-stage"><img src="{{art}}" alt="" loading="lazy"><span class="card-type-badge">{{typeLabel}}</span><span class="card-cost">1 AP</span></div>
  <div class="card-ability-body"><small>{{stationLabel}} · {{status}}</small><label><input type="checkbox" data-plan-card value="{{id}}" {{#unless enabled}}disabled{{/unless}}><strong>{{name}}</strong></label><p>{{description}}</p>
  <details><summary>Roll outcomes</summary><dl><dt>Critical success</dt><dd>{{outcomes.criticalSuccess}}</dd><dt>Success</dt><dd>{{outcomes.success}}</dd><dt>Failure</dt><dd>{{outcomes.failure}}</dd><dt>Critical failure</dt><dd>{{outcomes.criticalFailure}}</dd></dl></details></div>
</article>{{/each}}</div><section class="card-basic-orders"><h3>Basic ship orders · 1 AP each</h3>{{#each basics}}<label>{{name}}<input aria-label="{{name}} order count" type="number" data-plan-basic="{{id}}" value="0" min="0" max="{{max}}" {{#unless ../canPlan}}disabled{{/unless}}></label>{{/each}}</section></div><div data-hand-panel="rp" hidden><p class="card-panel-hint">A separate shared RP pool. Choose a reaction in the incoming-fire prompt when attacked.</p><div class="card-combat-hand">{{#each reactions}}<article class="combat-ability-card card-{{type}}"><div class="card-art-stage"><img src="{{art}}" alt="" loading="lazy"><span class="card-type-badge">{{typeLabel}}</span><span class="card-cost">1 RP</span></div><div class="card-ability-body"><small>{{status}}</small><strong>{{name}}</strong><p>{{description}}</p><details><summary>Roll outcomes</summary><dl><dt>Critical success</dt><dd>{{outcomes.criticalSuccess}}</dd><dt>Success</dt><dd>{{outcomes.success}}</dd><dt>Failure</dt><dd>{{outcomes.failure}}</dd><dt>Critical failure</dt><dd>{{outcomes.criticalFailure}}</dd></dl></details></div></article>{{/each}}</div></div></div><footer class="card-plan-footer"><strong data-plan-budget>0 / {{budget}} AP selected</strong><button type="button" class="card-lock-button card-primary" data-card-command="lock" {{#unless canPlan}}disabled{{/unless}}>{{#if bonus}}Lock Additional Orders{{else}}Lock Captain's Plan{{/if}}</button></footer></aside>
  </div>
  {{/if}}
  <footer class="card-combat-note">Playtest · Encounter resources and chart positions are copies. First card libraries save to ships. 16 AP + 6 RP designs.</footer>
</section>
