<section class="round-tracker"><header><b>ROUND {{s.round}}</b><strong>{{label}}</strong><button data-round-open>Open hand</button></header><ol>{{#each steps}}<li class="{{#if active}}is-current{{/if}} {{#if done}}is-done{{/if}}" {{#if active}}aria-current="step"{{/if}}>{{number}} · {{label}}</li>{{/each}}</ol><div class="round-fleet-status">{{#each rows}}<span class="{{#if ready}}is-ready{{/if}}"><i>{{#if ready}}✓{{else}}…{{/if}}</i>{{name}} · {{label}}</span>{{/each}}</div></section>
