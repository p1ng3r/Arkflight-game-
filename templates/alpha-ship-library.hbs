<section class="alpha-shell alpha-library-shell">
<header class="alpha-header"><div><small>ARKFLIGHT · SHIP LIBRARY</small><h2>Techniques &amp; Loadouts</h2></div><select data-library-ship aria-label="Ship library">{{#each ships}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><button data-alpha-sound aria-pressed="{{preferences.sound}}">Sound {{#if preferences.sound}}on{{else}}off{{/if}}</button><details class="alpha-preferences"><summary>Settings</summary><div><label>Motion<select data-alpha-motion><option value="full" {{#if (eq preferences.preference 'full')}}selected{{/if}}>Full</option><option value="subtle" {{#if (eq preferences.preference 'subtle')}}selected{{/if}}>Subtle</option><option value="off" {{#if (eq preferences.preference 'off')}}selected{{/if}}>Off</option></select></label><label>Volume<input type="range" data-alpha-volume min="0" max="0.4" step="0.01" value="{{preferences.volume}}"></label></div></details></header>
<main class="alpha-body">
{{#if error}}<p class="alpha-error" role="alert">{{error}}</p>{{/if}}
{{#unless ships}}<p>No owned alpha ships are available. The GM creates the test fleet and grants Owner permission to its crew.</p>{{/unless}}
{{#if view}}
<div class="alpha-library-summary"><strong>{{view.name}}</strong><span>{{view.profile.name}} · L{{view.profile.level}}</span><span>{{view.learned.length}} learned · Deck capacity {{view.deckCapacity}} · Hand {{view.profile.hand}}</span></div>
<section class="alpha-quest-rewards" aria-label="Ship card rewards">
{{#if rewardOffer}}
  <header><small>ARKFLIGHT · CARD DISCOVERY</small><h3>Choose one of three</h3><p>{{#if rewardOffer.kind}}Reward: {{rewardOffer.rewardId}}{{/if}}</p></header>
  <div class="alpha-quest-reward-options">
  {{#each rewardOptions}}
    <article class="alpha-quest-reward-card" style="--alpha-category-accent:{{categoryAccent}}">
      <img src="{{art}}" alt="{{name}} card illustration" loading="lazy">
      <strong>{{name}}</strong><small>{{categoryLabel}} · {{ap}} AP</small>
      <p>{{text}}</p>
      <button class="alpha-primary" data-library-action="reward-pick" data-card-id="{{id}}" {{#unless @root.canPick}}disabled{{/unless}}>Choose this card</button>
    </article>
  {{/each}}
  </div>
  <p class="alpha-note">The selected card is permanently learned. It joins the active deck if there is space; otherwise it remains in the ship library for replacement.</p>
{{else}}
  {{#if gm}}<header><h3>Completed quest · card reward</h3><p>GM: enter the unique quest reference and present three unlearned cards to this ship.</p></header>
  <label>Quest reference <input data-library-reward-id value="{{rewardId}}" placeholder="e.g. stormvault-quest-01" {{#unless canOffer}}disabled{{/unless}}></label>
  <button data-library-action="reward-offer" {{#unless canOffer}}disabled{{/unless}}>Offer 3 cards</button>{{/if}}
{{/if}}
<p class="alpha-note">Quest rewards earned: {{rewardHistory.length}} · Active deck capacity: {{view.deckCapacity}} / 30</p>
</section>
{{#if view.locked}}<p class="alpha-warning">{{view.locked}} You can inspect the library here.</p>{{/if}}
{{#unless view.initialized}}<p class="alpha-note">Adopt this test ship's current deck as its permanent starting library. This preserves its card selection and does not grant the entire catalog.</p>{{#if canInitialize}}<button data-library-action="initialize">Initialize ship library</button>{{/if}}{{/unless}}
{{#if stale}}<p class="alpha-warning">The ship changed while this draft was open. Your draft is retained. Reload the stored loadout before saving.</p>{{/if}}
<nav class="alpha-setup-steps" aria-label="Ship setup">{{#each setupSteps}}<button data-library-action="setup-step" data-step="{{id}}" aria-pressed="{{selected}}">{{name}}</button>{{/each}}</nav>
{{#if setupProfile}}{{#if gm}}<section class="alpha-setup-profile"><h3>Hull, level, upgrades &amp; talents</h3><p class="alpha-note">Saves the alpha ship's hull, level, fittings and talents. All three loadouts are retained and revalidated. A refit can make them invalid; correct the deck before launch.</p><div class="alpha-form-grid"><label>Hull<select data-library-config="hullId" {{#unless editable}}disabled{{/unless}}>{{#each hulls}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Ship level<input type="number" min="1" max="20" value="{{config.level}}" data-library-config="level" {{#unless editable}}disabled{{/unless}}></label></div><h4>Upgrades</h4>{{#each upgrades}}<label class="alpha-check"><input type="checkbox" value="{{id}}" data-library-fitting="upgrades" {{#if checked}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}}> {{name}} · {{slot}} fitting</label>{{/each}}<h4>Talents</h4>{{#each talents}}<label class="alpha-check"><input type="checkbox" value="{{id}}" data-library-fitting="talents" {{#if checked}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}}> {{name}}</label>{{/each}}<button data-library-action="refit" {{#unless canRefit}}disabled{{/unless}}>Save ship profile / refit</button></section>{{else}}<p>The GM sets hulls, fittings and talents. You can inspect the selected ship in Review.</p>{{/if}}{{/if}}
{{#if setupCrew}}<section class="alpha-setup-crew"><h3>Assign the crew and inspect weapons</h3><p>Each station offers three PF2e skills. The assigned player rolls that station’s cards. The GM assigns combat crew during Opening, Maneuver, Planning or Cleanup.</p><button data-library-action="setup-crew">Open combat crew assignments</button><button data-library-action="open-sheet">Open ship sheet / equipment</button><p>Combat weapons use this alpha ship’s configured batteries. Inspect their arcs, reload and damage in the combat HUD; sheet equipment is not automatically converted into new alpha batteries.</p></section>{{/if}}
{{#if setupReview}}<section class="alpha-setup-review"><h3>Ready for the next encounter?</h3><p>{{view.profile.name}} · Level {{view.profile.level}} · Hull {{view.profile.maxHull}} · AC {{view.profile.ac}}</p><p>Speed {{view.profile.speed}} · AP {{view.profile.ap}} · Cargo {{view.profile.cargoBulk}} Bulk · Fitting capacity {{view.profile.fitting}}</p><p>Hand {{view.profile.hand}} · Deck capacity {{view.deckCapacity}} · Opening draw {{view.profile.opening}}</p>{{#if dirty}}<p class="alpha-warning">Unsaved changes remain. Return to Hull &amp; fittings or Combat deck to save before launch.</p>{{/if}}{{#each loadouts}}<p><b>{{name}}</b> · {{#if active}}Selected{{else}}Stored{{/if}}{{#if invalid}} · Needs correction{{/if}}</p>{{/each}}<p>Loadouts and learned cards persist on the ship. Refit and deck changes are locked during combat.</p><button data-library-action="open-sheet">Open ship sheet</button></section>{{/if}}
{{#if setupDeck}}
<nav class="alpha-loadout-tabs" aria-label="Saved deck loadouts">{{#each loadouts}}<button data-library-slot="{{id}}" class="theme-standard {{#if selected}}is-active{{/if}} {{#if active}}is-selected{{/if}}"><span class="alpha-card-back" aria-hidden="true">✦</span><span><strong>{{name}}</strong><small>{{#if active}}Selected for combat{{else}}{{#if invalid}}Needs correction{{else}}Saved loadout{{/if}}{{/if}}</small></span></button>{{/each}}</nav>
<section class="alpha-library-deck">
<p><strong>{{count}} cards / {{view.deckCapacity}}</strong>{{#if dirty}} · Unsaved draft{{/if}} · Learning a card unlocks its permitted copies.</p>
{{#each issues}}<p class="alpha-library-issue">{{text}}</p>{{/each}}
{{#each unavailable}}<p class="alpha-warning">Unavailable card · {{count}} copies retained. <button data-library-action="remove-unavailable" data-card-id="{{id}}" {{#unless @root.editable}}disabled{{/unless}}>Remove from this draft</button></p>{{/each}}
<div class="alpha-actions"><button class="alpha-primary" data-library-action="save" {{#unless canSaveDeck}}disabled{{/unless}}>Save loadout draft</button><button data-library-action="select" {{#unless canSelect}}disabled{{/unless}}>Select for next combat</button><button data-library-action="reload" {{#if busy}}disabled{{/if}}>Reload stored loadout</button></div>
<p class="alpha-note">Drafts stay intact. Correct warnings before selecting for combat.</p><details class="alpha-library-settings"><summary>Loadout name &amp; settings</summary><label>Saved loadout<select data-library-loadout>{{#each loadouts}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}{{#if active}} · Selected for combat{{/if}}{{#if invalid}} · Needs correction{{/if}}</option>{{/each}}</select></label>
<label>Loadout name<input data-library-name maxlength="48" value="{{draft.name}}" {{#unless editable}}disabled{{/unless}}></label>
<p class="alpha-note">Switching ship/loadout or reloading discards unsaved edits. Saved decks are never pruned automatically.</p></details>
</section>
<label>{{#if gm}}Search full catalog{{else}}Search learned cards{{/if}}<input data-library-search value="{{search}}" placeholder="Card name"></label>
<div class="alpha-library-catalog">{{#each catalog}}<article class="alpha-library-card theme-{{theme}} category-{{category}} {{#unless learned}}is-unlearned{{/unless}}" style="--alpha-category-accent:{{categoryAccent}}"><span class="alpha-library-band">{{band}}</span><span class="alpha-cost">{{ap}}</span><img src="{{art}}" alt=""><div><h3>{{name}}</h3><small>{{categoryLabel}} · {{role}}{{#if unique}} · Unique{{/if}}</small><div class="alpha-library-tags" aria-label="Card tags">{{#each tagLabels}}<span>{{this}}</span>{{/each}}</div><p>{{text}}</p><details class="alpha-library-inspect"><summary>Inspect four outcomes</summary><div class="alpha-outcomes">{{#each outcomes}}<section class="alpha-outcome is-{{theme}}"><strong>{{label}}</strong><span>{{text}}</span></section>{{/each}}</div></details><label>Copies in draft · maximum {{max}}</label><div class="alpha-library-copy-controls"><button data-library-adjust="-1" data-card-id="{{id}}" {{#unless canDecrease}}disabled{{/unless}} aria-label="Remove one {{name}}">−</button><input type="number" min="0" max="{{max}}" value="{{count}}" data-library-count="{{id}}" aria-label="Copies of {{name}}" {{#unless editable}}disabled{{/unless}}><button data-library-adjust="1" data-card-id="{{id}}" {{#unless canIncrease}}disabled{{/unless}} aria-label="Add one {{name}}">+</button></div>{{#if @root.gm}}{{#if learned}}<button data-library-action="remove" data-card-id="{{id}}" {{#unless @root.canGrant}}disabled{{/unless}}>Remove learned card</button>{{else}}<button data-library-action="grant" data-card-id="{{id}}" {{#unless @root.canGrant}}disabled{{/unless}}>Grant to ship</button>{{/if}}{{/if}}</div></article>{{/each}}</div>
{{/if}}
{{/if}}
</main><footer class="alpha-footer"><span>Ship-owned · edits outside combat</span><button data-library-action="minimize">Minimize</button></footer>
</section>
