<section class="alpha-shell alpha-library-shell">
<header class="alpha-header"><div><small>ARKFLIGHT · SHIP LIBRARY</small><h2>Techniques &amp; Loadouts</h2></div><select data-library-ship aria-label="Ship library">{{#each ships}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></header>
<main class="alpha-body">
{{#if error}}<p class="alpha-error" role="alert">{{error}}</p>{{/if}}
{{#unless ships}}<p>No owned alpha ships are available. The GM creates the test fleet and grants Owner permission to its crew.</p>{{/unless}}
{{#if view}}
<div class="alpha-library-summary"><strong>{{view.name}}</strong><span>{{view.profile.name}} · L{{view.profile.level}}</span><span>{{view.learned.length}} learned · Deck capacity {{view.profile.deck}} · Hand {{view.profile.hand}}</span></div>
{{#if view.locked}}<p class="alpha-warning">{{view.locked}} You can inspect the library here.</p>{{/if}}
{{#unless view.initialized}}<p class="alpha-note">Adopt this test ship's current deck as its permanent starting library. This preserves its card selection and does not grant the entire catalog.</p>{{#if canInitialize}}<button data-library-action="initialize">Initialize ship library</button>{{/if}}{{/unless}}
{{#if stale}}<p class="alpha-warning">The ship changed while this draft was open. Your draft is retained. Reload the stored loadout before saving.</p>{{/if}}
<section class="alpha-library-deck">
<label>Saved loadout<select data-library-loadout>{{#each loadouts}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}{{#if active}} · Selected for combat{{/if}}{{#if invalid}} · Needs correction{{/if}}</option>{{/each}}</select></label>
<label>Loadout name<input data-library-name maxlength="48" value="{{draft.name}}" {{#unless editable}}disabled{{/unless}}></label>
<p><strong>{{count}} cards / {{view.profile.deck}}</strong>{{#if dirty}} · Unsaved draft{{/if}} · Learning a card unlocks its permitted copies.</p>
{{#each issues}}<p class="alpha-library-issue">{{text}}</p>{{/each}}
{{#each unavailable}}<p class="alpha-warning">Unavailable card · {{count}} copies retained. <button data-library-action="remove-unavailable" data-card-id="{{id}}" {{#unless @root.editable}}disabled{{/unless}}>Remove from this draft</button></p>{{/each}}
<div class="alpha-actions"><button class="alpha-primary" data-library-action="save" {{#unless canSaveDeck}}disabled{{/unless}}>Save loadout draft</button><button data-library-action="select" {{#unless canSelect}}disabled{{/unless}}>Select for next combat</button><button data-library-action="reload" {{#if busy}}disabled{{/if}}>Reload stored loadout</button></div>
<p class="alpha-note">Invalid drafts remain saved without deleting cards. A selected loadout must be valid before a new encounter starts. Switching ship/loadout or reloading discards unsaved edits.</p>
</section>
<label>{{#if gm}}Search full catalog{{else}}Search learned cards{{/if}}<input data-library-search value="{{search}}" placeholder="Card name"></label>
<div class="alpha-library-catalog">{{#each catalog}}<article class="alpha-library-card {{#unless learned}}is-unlearned{{/unless}}"><img src="{{art}}" alt=""><div><h3>{{name}}</h3><small>{{ap}} AP · {{timing}}{{#if burn}} · Burn{{/if}}</small><p>{{text}}</p><label>Copies in draft · maximum {{max}}<input type="number" min="0" max="{{max}}" value="{{count}}" data-library-count="{{id}}" {{#unless editable}}disabled{{/unless}}></label>{{#if @root.gm}}{{#if learned}}<button data-library-action="remove" data-card-id="{{id}}" {{#unless @root.canGrant}}disabled{{/unless}}>Remove learned card</button>{{else}}<button data-library-action="grant" data-card-id="{{id}}" {{#unless @root.canGrant}}disabled{{/unless}}>Grant to ship</button>{{/if}}{{/if}}</div></article>{{/each}}</div>
{{#if gm}}<details><summary>Ship profile / refit</summary><p class="alpha-note">Saves the alpha ship's hull, level, fittings and talents. All three loadouts are retained and revalidated. A refit can make them invalid; correct the deck before launch.</p><div class="alpha-form-grid"><label>Hull<select data-library-config="hullId" {{#unless editable}}disabled{{/unless}}>{{#each hulls}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Ship level<input type="number" min="1" max="20" value="{{config.level}}" data-library-config="level" {{#unless editable}}disabled{{/unless}}></label></div><h4>Upgrades</h4>{{#each upgrades}}<label class="alpha-check"><input type="checkbox" value="{{id}}" data-library-fitting="upgrades" {{#if checked}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}}> {{name}} · {{slot}} fitting</label>{{/each}}<h4>Talents</h4>{{#each talents}}<label class="alpha-check"><input type="checkbox" value="{{id}}" data-library-fitting="talents" {{#if checked}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}}> {{name}}</label>{{/each}}<button data-library-action="refit" {{#unless canRefit}}disabled{{/unless}}>Save ship profile / refit</button></details>{{/if}}
{{/if}}
</main><footer class="alpha-footer"><span>Ship-owned · edits outside combat</span><button data-library-action="minimize">Minimize</button></footer>
</section>
