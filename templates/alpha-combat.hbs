{{#*inline "ventMaster"}}
<section class="alpha-master-wrap" aria-label="Vent Strain master card">
<div class="alpha-master-toolbar"><span>{{#if masterPreview}}CARD FORGE · ENGINEER MASTER{{else}}ENGINEER · CARD INSPECTION{{/if}}</span>{{#unless masterPreview}}<button type="button" data-alpha-cmd="close-inspector">Close</button>{{/unless}}</div>
<article class="alpha-master-card alpha-card-detail">
<div class="alpha-master-hero"><img class="alpha-master-painting" src="{{ventMaster.art}}" alt="An engineer opens a brass valve as turquoise Arkengine steam spirals above a wooden catwalk."><header class="alpha-master-header"><div><h3>{{ventMaster.name}}</h3><small>ENGINEER · STANDARD</small></div><span class="alpha-master-ap" aria-label="{{ventMaster.ap}} action points">{{ventMaster.ap}}<small>AP</small></span></header></div>
<div class="alpha-master-parchment"><p>{{ventMaster.text}}</p><details class="alpha-master-outcome-details"><summary>Four roll outcomes</summary><div class="alpha-master-outcomes">{{#each ventMaster.outcomes}}<section class="alpha-master-outcome is-{{theme}}"><strong>{{label}}</strong><span>{{text}}</span></section>{{/each}}</div></details>{{#unless masterPreview}}{{#unless ventMaster.receipt}}<label>Engineer skill<select data-alpha-skill>{{#each skillOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/unless}}{{/unless}}</div>
<img class="alpha-master-frame" src="{{ventMaster.frame}}" alt="" aria-hidden="true">
<footer class="alpha-master-foot">
{{#if ventMaster.receipt}}<div class="alpha-master-receipt" role="status"><h4>{{ventMaster.receipt.label}} · {{ventMaster.receipt.total}}</h4><span>{{ventMaster.receipt.skillName}} · DC {{ventMaster.receipt.dc}}</span><dl><dt>d20</dt><dd>{{ventMaster.receipt.die}}</dd>{{#each ventMaster.receipt.components}}<dt>{{label}}</dt><dd>{{display}}</dd>{{/each}}<dt>Total</dt><dd>{{ventMaster.receipt.total}}</dd></dl><p>Resolved once · {{ventMaster.ap}} AP spent · card discarded.</p></div>
{{else}}<button type="button" class="alpha-master-roll" data-alpha-cmd="play" {{#if masterPreview}}disabled{{/if}} {{#unless playable}}disabled{{/unless}} {{#if busy}}disabled{{/if}} aria-label="Play Vent Strain and roll Engineer check for {{ventMaster.ap}} AP"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i><span>{{#if busy}}Resolving…{{else}}Play &amp; roll · {{ventMaster.ap}} AP{{/if}}</span></button><p>{{#if masterPreview}}Visual preview · inspect Vent Strain in your combat hand to play.{{else}}{{#unless playable}}{{cardHint}}{{else}}Engineer owner rolls · GM may operate any station.{{/unless}}{{/if}}</p>{{/if}}
</footer></article>
{{#if canRegroup}}{{#unless masterPreview}}<button type="button" data-alpha-cmd="regroup" {{#if busy}}disabled{{/if}}>Regroup selected · 1 AP</button>{{/unless}}{{/if}}
</section>
{{/inline}}
<section class="alpha-shell {{#if compact}}is-compact{{/if}}">
<header class="alpha-header"><div class="alpha-brand"><small>ARKFLIGHT · COMMAND DECK</small><h2>{{phaseName}}</h2></div>{{#if s}}<b class="alpha-round">R{{s.round}}</b><select data-alpha-ship aria-label="Selected ship">{{#each ships}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{#if active}}▶ {{/if}}{{name}} · {{ap}} AP{{#if locked}} · Locked{{/if}}</option>{{/each}}</select>{{/if}}<button class="alpha-sound-toggle" data-alpha-sound aria-pressed="{{preferences.sound}}">Sound {{#if preferences.sound}}on{{else}}off{{/if}}</button><details class="alpha-preferences"><summary aria-label="Motion and volume settings">Settings</summary><div><label>Motion<select data-alpha-motion><option value="full" {{#if (eq preferences.preference 'full')}}selected{{/if}}>Full</option><option value="subtle" {{#if (eq preferences.preference 'subtle')}}selected{{/if}}>Subtle</option><option value="off" {{#if (eq preferences.preference 'off')}}selected{{/if}}>Off</option></select></label><label>Volume<input data-alpha-volume type="range" min="0" max="0.4" step="0.01" value="{{preferences.volume}}"></label>{{#if preferences.reduced}}<small>Your reduced-motion preference is active.</small>{{/if}}</div></details><button data-alpha-cmd="compact">{{#if compact}}Expand{{else}}Compact{{/if}}</button></header>
{{#if s}}<ol class="alpha-phase-rail" aria-label="Combat phases">{{#each presentation.steps}}<li class="{{#if active}}is-current{{/if}} {{#if done}}is-done{{/if}}" {{#if active}}aria-current="step"{{/if}}><span>{{number}}</span>{{label}}</li>{{/each}}</ol>{{/if}}
{{#if ship}}<div class="alpha-meters"><div class="alpha-ap"><strong>{{ship.ap}}<small>AP</small></strong><div aria-hidden="true">{{#each apPips}}<i class="{{#if spent}}is-spent{{/if}}"></i>{{/each}}</div></div>{{#each meters}}<span data-alpha-meter="{{name}}" class="{{#if warning}}is-warning{{/if}}" title="{{label}} {{value}} / {{max}}"><small>{{label}}</small><b>{{value}}</b><i><em style="width:{{percent}}%"></em></i></span>{{/each}}</div>{{/if}}
<nav class="alpha-tabs">{{#each tabs}}<button type="button" data-alpha-tab="{{id}}" class="{{#if selected}}is-active{{/if}}" aria-pressed="{{selected}}">{{name}}</button>{{/each}}</nav>
<main class="alpha-body">
{{#if masterPreview}}{{> ventMaster}}{{/if}}
{{#unless showHand}}<p class="alpha-phase-hint">{{presentation.hint}}</p>{{/unless}}
{{#if paused}}<p class="alpha-warning">Foundry is paused. Unpause before executing actions.</p>{{/if}}
{{#if error}}<p class="alpha-error" role="alert">{{error}}</p>{{/if}}
{{#unless showHand}}{{#if gm}}{{#if suggestion}}<details class="alpha-guide" {{#if guideOpen}}open{{/if}}><summary>Guided test · {{suggestion.label}}</summary><p>Next Step performs exactly this one action through the same controller as manual play. It waits for your next click.</p></details>{{/if}}{{/if}}{{/unless}}
{{#if hasRecovery}}<section class="alpha-warning"><h3>Saved movement needs attention</h3><p>{{recovery.error}}</p><p>Resolved rolls and destinations are preserved. Resume completes this move; restore returns the ships to their initial poses.</p>{{#if gm}}<button data-alpha-cmd="resume-movement" {{#if busy}}disabled{{/if}}>Resume saved movement</button><button data-alpha-cmd="restore-movement" {{#if busy}}disabled{{/if}}>Restore initial poses</button>{{/if}}</section>{{/if}}
{{#each choices}}<section class="alpha-choice"><h3>{{name}} · Complication choice</h3>{{#if allowed}}{{#each options}}<button data-alpha-cmd="choose-complication" data-ship-id="{{../shipId}}" data-choice-id="{{../id}}" data-option-id="{{id}}" {{#unless available}}disabled{{/unless}} {{#if @root.busy}}disabled{{/if}}>{{label}}{{#unless available}} — unavailable{{/unless}}</button>{{/each}}{{else}}<p>Waiting for this ship's crew.</p>{{/if}}</section>{{/each}}
{{#if pendingDiscard}}<p class="alpha-warning">Raise exactly {{pendingDiscard}} cards · {{selectionCount}} selected. <button data-alpha-cmd="discard" {{#unless canDiscard}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>Discard selected</button></p>{{/if}}
{{#if cleanup}}<section class="alpha-round-summary"><div><small>EXCHANGE COMPLETE</small><h3>Round {{s.round}} resolved</h3><p>Review the results below, then refresh AP and draw for the next round.</p></div>{{#if gm}}<button class="alpha-primary" data-alpha-cmd="round" {{#if busy}}disabled{{/if}}>Start next round</button>{{/if}}</section>{{/if}}
{{#if showBuild}}
  <p class="alpha-note">Create a dedicated alpha fleet and hex scene. Campaign ships are preserved. These hull, card and upgrade values are for tuning.</p>
  <div class="alpha-form-grid"><label>Party hull<select data-alpha-build="hullId">{{#each hulls}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Opposing hull<select data-alpha-build="enemyHullId">{{#each hulls}}<option value="{{id}}" {{#if enemySelected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Ship level<input type="number" min="1" max="20" value="{{build.level}}" data-alpha-build="level"></label><label>Fleet size<select data-alpha-build="count"><option value="2">2 ships</option><option value="4" {{#if (eq build.count 4)}}selected{{/if}}>4 ships</option></select></label></div>
  <section class="alpha-profile"><h3>{{profile.name}} · Level {{profile.level}}</h3><p>{{profile.role}}</p><p>Hull {{profile.maxHull}} · AC {{profile.ac}} · Speed {{profile.speed}} · Footprint {{profile.footprint}} hex(es)</p><p>Hold {{profile.cargoBulk}} Bulk · {{profile.fitting}} fitting slots · Hand {{profile.hand}} · Deck capacity {{profile.deck}}</p></section>
  <details><summary>Upgrades and talents</summary><h4>Upgrades · use fitting slots</h4>{{#each upgrades}}<label class="alpha-check"><input type="checkbox" value="{{id}}" data-alpha-fit="upgrades" {{#if checked}}checked{{/if}}> {{name}} · level {{minLevel}} · {{slot}} slot</label>{{/each}}<h4>Ship talents</h4>{{#each talents}}<label class="alpha-check"><input type="checkbox" value="{{id}}" data-alpha-fit="talents" {{#if checked}}checked{{/if}}> {{name}} · level {{minLevel}}</label>{{/each}}</details>
  <p class="alpha-note">Existing ships retain their learned library and selected loadout. Use Library / Decks to edit them; Builder changes their hull/profile for this test. The starter selection below seeds newly created ships only.</p>
  <details><summary>Starter combat deck · {{deckCount}} cards selected</summary><p>15 cards minimum. Up to two copies; Unique Burn cards one copy. The five-card opening hand is random.</p><div class="alpha-deck-builder">{{#each deckOptions}}<label>{{name}} · {{ap}} AP<input type="number" min="0" max="{{max}}" value="{{count}}" data-alpha-deck="{{id}}"></label>{{/each}}</div></details>
  {{#if buildError}}<p class="alpha-error">{{buildError}}</p>{{/if}}
  {{#if gm}}<button class="alpha-primary" data-alpha-cmd="start" {{#unless canStart}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>Build test fleet and start</button>{{#if s}}{{#if complete}}<button data-alpha-cmd="start-saved" {{#if busy}}disabled{{/if}}>Start battle with saved ships / loadouts</button>{{/if}}{{/if}}{{#if s}}{{#unless complete}}<p>End the active alpha encounter before rebuilding.</p>{{/unless}}{{/if}}{{else}}<p>The GM creates the alpha encounter. Reopen this window when it is ready.</p>{{/if}}
{{/if}}
{{#if s}}{{#unless ship}}<p class="alpha-note">No ship access is assigned to you. Ask the GM to grant Owner permission on your crew’s ship.</p>{{/unless}}{{/if}}
{{#if showPlan}}
{{#if planning}}{{#if ship}}<div class="alpha-section-heading"><div><small>NAVIGATOR'S TABLE</small><h3>{{ship.profile.name}}</h3></div><span class="alpha-status {{#if locked}}is-ready{{/if}}">{{#if locked}}Course locked{{else}}Awaiting course{{/if}}</span></div>{{#if canPlan}}<label>Choose a complete maneuver<select data-alpha-maneuver {{#if locked}}disabled{{/if}}>{{#each routes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · {{ap}} AP · {{description}}</option>{{/each}}</select></label>
{{#if route}}<section class="alpha-route"><div>{{{route.svg}}}</div><div><span class="alpha-kicker">MANEUVER TEMPLATE · {{route.ap}} AP</span><h3>{{route.name}}</h3><p>{{route.description}}</p><small>One hex per shared step. Turns happen at the printed waypoints.</small><button data-alpha-cmd="preview">Trace course on canvas</button></div></section>{{/if}}{{else}}<p class="alpha-note">Your assigned Navigator stages the course. The Captain can lock it after staging.</p>{{/if}}
<div class="alpha-actions">{{#if canPlan}}<button data-alpha-cmd="plan" {{#if locked}}disabled{{/if}} {{#if busy}}disabled{{/if}}>Stage maneuver</button>{{/if}}<button class="alpha-primary" data-alpha-cmd="lock" {{#if locked}}disabled{{/if}} {{#unless canLock}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>{{#if locked}}Course locked{{else}}Lock maneuver{{/if}}</button>{{#if gm}}<button data-alpha-cmd="ready-enemies" {{#if busy}}disabled{{/if}}>Ready enemies · Straight 3</button><button data-alpha-cmd="move" {{#unless canMove}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>Reveal &amp; move fleet</button>{{/if}}</div>{{/if}}{{/if}}
{{#if cardPhase}}<button class="alpha-primary" data-alpha-tab="hand">Open the card table</button>{{/if}}
{{#if targeting}}<h3>Declare firing solutions</h3>{{#each orders}}<section class="alpha-target-order"><label>{{name}}<select data-alpha-order-target="{{id}}" data-ship-id="{{shipId}}" {{#unless allowed}}disabled{{/unless}}><option value="">Choose a legal target</option>{{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><button data-alpha-cmd="hold-order" data-attack-id="{{id}}" data-ship-id="{{shipId}}" {{#unless allowed}}disabled{{/unless}}>Hold this shot</button></section>{{/each}}{{#if gm}}<button class="alpha-primary" data-alpha-cmd="begin-damage" {{#if busy}}disabled{{/if}}>Lock targets · Begin damage phase</button>{{/if}}{{/if}}
{{#if retargeting}}<h3>The firing solution changed</h3><p>Choose one replacement target, or hold the shot. AP remains spent; a held shot spends no ammunition or reload.</p>{{#if canRetarget}}{{#each retargets}}<button data-alpha-cmd="retarget" data-target-id="{{id}}" data-ship-id="{{@root.pending.shipId}}">Target {{name}}</button>{{/each}}<button data-alpha-cmd="retarget" data-ship-id="{{pending.shipId}}">Hold shot</button>{{/if}}{{/if}}
{{#if responding}}<button class="alpha-primary" data-alpha-tab="hand">Open the response window</button>{{/if}}
{{/if}}
{{#if results}}<details class="alpha-recent-results" {{#if resultsOpen}}open{{/if}}><summary>{{#with results.[0]}}{{#if check}}{{station}} · d20 {{die}} {{modifierText}} = {{total}} · {{label}}{{else}}{{damage}} Hull damage · {{#if missed}}Miss{{else}}{{#if pendingDamage}}Queued{{else}}Resolved{{/if}}{{/if}}{{/if}}{{/with}} <span> · Details</span></summary><div class="alpha-results">{{#each results}}<article class="alpha-result-card is-{{theme}}" data-result-id="{{id}}">{{#if check}}<span class="alpha-die" aria-label="d20 result {{die}}">{{die}}</span><div><small>{{shipName}} · {{station}}</small><strong>{{label}}</strong><span>d20 {{die}} {{modifierText}} = <b>{{total}}</b> vs {{dc}}</span></div>{{else}}<span class="alpha-damage-number">{{damage}}</span><div><small>{{shipName}} → {{targetName}}</small><strong>{{#if missed}}Miss · no damage roll{{else}}{{#if pendingDamage}}Hull damage queued{{else}}Hull damage resolved{{/if}}{{/if}}</strong><span>{{#unless missed}}{{formula}} = {{rolled}}{{#if (eq degree 2)}} × 2 critical{{/if}} · {{mitigated}} prevented{{/unless}}</span></div>{{/if}}</article>{{/each}}</div></details>{{/if}}
{{#if showHand}}{{#if ship}}
<div class="alpha-turn-summary"><div><small>{{#if presentation.yourTurn}}YOUR SHIP'S CARD PHASE{{else}}CREW HAND{{/if}}</small><h3>{{ship.name}}</h3></div><button data-alpha-cmd="show-weapons">Weapons</button><button data-alpha-cmd="fold-hand">{{#if handFolded}}Show hand{{else}}Fold hand{{/if}}</button>{{#if canFinish}}<button class="alpha-primary" data-alpha-cmd="finish-card" {{#if busy}}disabled{{/if}}>Finish Card phase</button>{{/if}}</div>
{{#if responding}}<section class="alpha-response"><div><small>INCOMING ATTACK</small><b>{{pending.attacker}} → {{pending.defender}}</b></div>{{#if canRespond}}<button data-alpha-cmd="pass-response" {{#if busy}}disabled{{/if}}>Pass response</button>{{/if}}{{#if pending.ready}}{{#if canRollAttack}}<button class="alpha-primary" data-alpha-cmd="attack" data-ship-id="{{pending.shipId}}" {{#if busy}}disabled{{/if}}>Roll attack &amp; damage</button>{{/if}}{{/if}}</section>{{/if}}
<nav class="alpha-deck-piles" aria-label="Card piles">{{#each piles}}<button type="button" data-alpha-pile="{{id}}" class="alpha-deck-pile theme-{{theme}}" title="{{hint}}"><span class="alpha-card-back" aria-hidden="true">✦</span><span><strong>{{name}}</strong><small>{{count}} cards</small></span></button>{{/each}}</nav>
{{#if pile}}<section class="alpha-pile-inspector"><div class="alpha-section-heading"><h3>{{pile.name}} · {{pile.count}}</h3><button data-alpha-cmd="close-inspector">Close</button></div>{{#if pile.receipt}}<article class="alpha-complication-reveal"><small>LAST REVEALED · {{pile.receipt.station}}</small><h3>{{pile.receipt.name}}</h3><b>{{pile.receipt.title}}</b><p>{{pile.receipt.text}}</p></article>{{else}}{{#each pile.cards}}<details><summary>{{name}} · {{ap}} AP</summary><p>{{text}}</p></details>{{else}}<p>{{pile.emptyText}}</p>{{/each}}{{/if}}</section>{{/if}}
{{#if canMulligan}}<div class="alpha-mulligan"><span>Opening hand · raise up to 2 cards to return · {{selectionCount}} selected</span><button data-alpha-cmd="mulligan" {{#unless canConfirmMulligan}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>Keep / mulligan selected</button></div>{{/if}}
{{#unless handFolded}}<div class="alpha-hand" aria-label="Crew card hand">{{#each hand}}<button type="button" class="alpha-playing-card {{#if master}}is-master-card{{/if}} theme-{{theme}} {{#if selected}}is-selected{{/if}} {{#unless affordable}}is-unaffordable{{/unless}}" data-alpha-card="{{instanceId}}" aria-pressed="{{selected}}" title="{{name}} · {{ap}} AP · Click to inspect"><span class="alpha-card-band">{{band}}</span><span class="alpha-cost" aria-label="{{ap}} action points">{{ap}}</span><span class="alpha-card-art"><img src="{{art}}" alt=""></span><strong>{{name}}</strong><small class="alpha-card-station">{{stationLabel}}</small><span class="alpha-card-role">{{role}}{{#if burn}} · Once this encounter{{/if}}</span>{{#if selected}}<span class="alpha-selected-mark">Selected</span>{{/if}}</button>{{else}}<p class="alpha-note">Your hand is empty. Basic weapons remain available; draw one card at the next round's start.</p>{{/each}}</div>{{else}}<div class="alpha-folded-hand"><b>{{ship.hand.length}} cards in hand</b><p>Your cards and deck are preserved. Show hand to inspect or play.</p></div>{{/unless}}
<section class="alpha-armory"><div class="alpha-section-heading"><h3>Weapons</h3><small>Commit now · target next phase</small></div><div class="alpha-batteries">{{#each batteries}}<article class="alpha-battery {{#if committed}}is-committed{{/if}} {{#if selected}}is-selected{{/if}}"><div><span class="alpha-kicker">{{mount}} · {{arc}}°</span><strong>{{name}}</strong><small>{{formula}} · Range {{range}} hex</small></div><span class="alpha-status {{#if ready}}is-ready{{/if}}">{{status}}</span><div class="alpha-battery-buttons"><button data-alpha-cmd="arcs" data-battery-id="{{id}}" title="Show {{name}} firing arc and range">Arc / range</button><button class="alpha-primary" data-alpha-cmd="fire" data-battery-id="{{id}}" {{#unless canCommit}}disabled{{/unless}} {{#if @root.busy}}disabled{{/if}}>Commit shot · 1 AP</button></div></article>{{/each}}</div><details class="alpha-gunnery-options"><summary>Gunnery skill &amp; weapon help</summary><label>Battle Watch skill<select data-alpha-attack-skill>{{#each attackSkillOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><p>{{fireHint}} A committed shot rolls to hit and damage in the Damage phase.</p></details></section>
{{#if card}}{{#if masterCard}}{{> ventMaster}}{{else}}<article class="alpha-card-detail theme-{{card.theme}}"><div class="alpha-inspector-face"><span class="alpha-card-band">{{card.band}} · {{card.stationLabel}}</span><span class="alpha-cost">{{card.ap}}</span><img src="{{card.art}}" alt=""><h3>{{card.name}}</h3><span>{{card.role}}</span></div><div class="alpha-inspector-rules"><div class="alpha-section-heading"><h3>{{card.name}}</h3><button data-alpha-cmd="close-inspector" aria-label="Close card inspection">Close</button></div><p>{{card.text}}</p><div class="alpha-outcomes">{{#each card.outcomes}}<section class="alpha-outcome is-{{theme}}"><strong>{{label}}</strong><span>{{text}}</span></section>{{/each}}</div>{{#if card.coordinated}}<p class="alpha-note">Coordinated: the first station prepares the effect; Battle Watch rolls the shot in the Damage phase.</p>{{/if}}
<div class="alpha-form-grid">{{#if card.attackOnly}}<label>Gunnery skill<select data-alpha-attack-skill>{{#each attackSkillOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{else}}<label>Station skill<select data-alpha-skill>{{#each skillOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}{{#if card.needsBattery}}<label>Battery<select data-alpha-battery>{{#each batteries}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · {{status}}</option>{{/each}}</select></label>{{/if}}</div>
{{#if (eq card.id 'boarding')}}<label>Boarding target<select data-alpha-target><option value="">Choose target</option>{{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}{{#if card.movementCard}}<label>Movement adjustment<select data-alpha-adjustment>{{#each adjustments}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
<div class="alpha-actions"><button class="alpha-primary" data-alpha-cmd="play" {{#unless playable}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>Play {{card.name}} · {{card.ap}} AP</button>{{#if canRegroup}}<button data-alpha-cmd="regroup" {{#if busy}}disabled{{/if}}>Regroup selected · 1 AP</button>{{/if}}</div>{{#unless playable}}<p class="alpha-note">{{cardHint}}</p>{{/unless}}{{#each boardingExploits}}<button data-alpha-cmd="play" data-effect-id="{{id}}">Use boarding opening · +1 AP</button>{{/each}}</div></article>{{/if}}{{/if}}
{{#each exploits}}<button data-alpha-cmd="exploit" data-effect-id="{{id}}" data-ship-id="{{payer}}" {{#if @root.busy}}disabled{{/if}}>Exploit {{name}} · 1 additional AP</button>{{/each}}
{{/if}}{{/if}}
{{#if showShip}}<h3>{{ship.name}} · {{ship.profile.name}} L{{ship.profile.level}}</h3><p>AC {{ship.profile.ac}} · Hull {{ship.profile.maxHull}} · Structure +{{ship.profile.structure}} · Support DC {{ship.profile.dc}} · {{ship.profile.footprint}} occupied hex(es)</p><p>Hold {{ship.profile.cargoBulk}} Bulk · Slots {{ship.profile.fitting}} · Deck {{ship.profile.deck}} · Hand {{ship.profile.hand}}</p><p>Hex {{ship.pose.q}}, {{ship.pose.r}} · Heading {{ship.pose.heading}}</p><h4>Weapons</h4>{{#each weaponDetails}}<p><b>{{name}}</b> · {{formula}} damage · Range {{range}} hex · {{arc}}° arc · Reload {{reload}}</p>{{/each}}<button data-alpha-cmd="find">Find ship token</button>
<details open><summary>Stations and crew</summary>{{#each stations}}<label>{{name}} · {{skills}}<select data-alpha-assign="{{id}}" {{#unless @root.gm}}disabled{{/unless}}><option value="">NPC crew · ship baseline</option>{{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/each}}<p class="alpha-note">PC skill checks use ship level + crew attribute + training. Personal level is not added again.</p></details>
<details><summary>Capabilities across pillars</summary><p>Travel Supply reduction: {{ship.profile.capabilities.travelSupplyReduction}} · Cruise bonus: {{ship.profile.capabilities.travelSpeedBonus}} · Trade bonus: {{ship.profile.capabilities.tradeBonus}}</p><p>Event tags: {{ship.profile.capabilities.eventTags}}</p><small>These alpha capabilities are recorded for testing; legacy travel/events are not automatically rewritten.</small></details>
{{#if boarding}}<section class="alpha-warning"><h4>Boarding lines secured</h4><p>The ship battle can pause for a prepared PF2e deck scene. Use normal Foundry character tokens there, then return to this saved battle.</p>{{#if gm}}{{#if boardingPaused}}<button data-alpha-cmd="return-boarding">Return to ship battle</button>{{else}}<select data-alpha-boarding-scene><option value="">Choose prepared deck scene</option>{{#each boardingScenes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><button data-alpha-cmd="open-boarding">Pause ship battle · Open deck</button>{{/if}}{{/if}}</section>{{/if}}
<h4>Prepared effects</h4>{{#each prepared}}<p>{{kind}} +{{amount}} · Round {{start}}–{{end}}</p>{{/each}}<h4>Complications</h4>{{#each effects}}<p>{{label}} · Expires after R{{expiresRound}}</p>{{/each}}
{{/if}}
{{#if showLog}}<p class="alpha-note">Build: {{buildId}}</p><button data-alpha-cmd="report">Copy alpha diagnostic report</button>{{#if report}}<textarea readonly rows="8" aria-label="Alpha diagnostic report">{{report}}</textarea>{{/if}}{{#if complete}}<p class="alpha-warning">Encounter ended. Review results or open Builder for another test.</p>{{/if}}<div class="alpha-log">{{#each history}}<p><small>R{{round}}</small> {{text}}</p>{{/each}}</div>{{/if}}
</main>
<footer class="alpha-footer"><button data-alpha-cmd="library">Library / Decks</button><span class="alpha-live-status" role="status">{{#if busy}}Resolving…{{else}}Ready{{/if}}</span>{{#if gm}}{{#if suggestion}}<button class="alpha-primary" data-alpha-cmd="next-step" title="{{suggestion.label}}" {{#if busy}}disabled{{/if}}>Next Step</button>{{/if}}{{/if}}<button data-alpha-cmd="minimize">Minimize</button><details class="alpha-tools"><summary>Tools</summary><div>{{#if s}}<button data-alpha-cmd="scene">View scene</button>{{/if}}<button data-alpha-cmd="hide-overlay">Clear preview</button>{{#if gm}}{{#if s}}{{#unless complete}}<button data-alpha-cmd="end" {{#if busy}}disabled{{/if}}>End alpha test</button>{{/unless}}{{/if}}{{/if}}</div></details></footer>
</section>
