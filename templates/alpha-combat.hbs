<section class="alpha-shell">
<header class="alpha-header"><div><small>ARKFLIGHT · 1.1 ALPHA</small><h2>{{phaseName}}</h2></div>{{#if s}}<b>R{{s.round}}</b><select data-alpha-ship aria-label="Selected ship">{{#each ships}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{#if active}}▶ {{/if}}{{name}} · {{ap}} AP{{#if locked}} · Ready{{/if}}</option>{{/each}}</select>{{/if}}</header>
{{#if ship}}<div class="alpha-meters"><strong>{{ship.ap}} AP</strong>{{#each meters}}<span class="{{#if warning}}is-warning{{/if}}" title="{{name}} {{value}} / {{max}}"><small>{{name}}</small><b>{{value}}</b><i><em style="width:{{percent}}%"></em></i></span>{{/each}}</div>{{/if}}
<nav class="alpha-tabs">{{#each tabs}}<button type="button" data-alpha-tab="{{id}}" class="{{#if selected}}is-active{{/if}}">{{name}}</button>{{/each}}</nav>
<main class="alpha-body">
{{#if gm}}{{#if suggestion}}<details class="alpha-guide" {{#if guideOpen}}open{{/if}}><summary>Guided alpha test · one step per click</summary><p>{{suggestion.label}}</p><button class="alpha-primary" data-alpha-cmd="next-step" {{#if busy}}disabled{{/if}}>Next suggested step</button><small>Uses the same rules and native movement as manual play. No autoplay.</small></details>{{/if}}{{/if}}
{{#if paused}}<p class="alpha-warning">Foundry is paused. Unpause before executing actions.</p>{{/if}}
{{#if error}}<p class="alpha-error" role="alert">{{error}}</p>{{/if}}
{{#if hasRecovery}}<section class="alpha-warning"><h3>Saved movement needs attention</h3><p>{{recovery.error}}</p><p>The resolved rolls and destination are preserved. Resume completes that same move; restore returns the test ships to the starting poses.</p>{{#if gm}}<button data-alpha-cmd="resume-movement" {{#if busy}}disabled{{/if}}>Resume saved movement</button><button data-alpha-cmd="restore-movement" {{#if busy}}disabled{{/if}}>Restore initial poses</button>{{/if}}</section>{{/if}}
{{#each choices}}<section class="alpha-choice"><h3>{{name}} · Complication choice</h3>{{#if allowed}}{{#each options}}<button data-alpha-cmd="choose-complication" data-ship-id="{{../shipId}}" data-choice-id="{{../id}}" data-option-id="{{id}}" {{#unless available}}disabled{{/unless}} {{#if @root.busy}}disabled{{/if}}>{{label}}{{#unless available}} — unavailable{{/unless}}</button>{{/each}}{{else}}<p>Waiting for this ship's crew.</p>{{/if}}</section>{{/each}}
{{#if pendingDiscard}}<p class="alpha-warning">Select exactly {{pendingDiscard}} raised cards, then <button data-alpha-cmd="discard" {{#if busy}}disabled{{/if}}>Discard selected</button></p>{{/if}}
{{#if showBuild}}
  <p class="alpha-note">Create a dedicated alpha fleet and hex scene. Campaign ships are preserved. These hull, card and upgrade values are for tuning.</p>
  <div class="alpha-form-grid"><label>Party hull<select data-alpha-build="hullId">{{#each hulls}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Opposing hull<select data-alpha-build="enemyHullId">{{#each hulls}}<option value="{{id}}" {{#if enemySelected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Ship level<input type="number" min="1" max="20" value="{{build.level}}" data-alpha-build="level"></label><label>Fleet size<select data-alpha-build="count"><option value="2">2 ships</option><option value="4" {{#if (eq build.count 4)}}selected{{/if}}>4 ships</option></select></label></div>
  <section class="alpha-profile"><h3>{{profile.name}} · Level {{profile.level}}</h3><p>{{profile.role}}</p><p>Hull {{profile.maxHull}} · AC {{profile.ac}} · Speed {{profile.speed}} · Footprint {{profile.footprint}} hex(es)</p><p>Hold {{profile.cargoBulk}} Bulk · {{profile.fitting}} fitting slots · Hand {{profile.hand}} · Deck capacity {{profile.deck}}</p></section>
  <details><summary>Upgrades and talents</summary><h4>Upgrades · use fitting slots</h4>{{#each upgrades}}<label class="alpha-check"><input type="checkbox" value="{{id}}" data-alpha-fit="upgrades" {{#if checked}}checked{{/if}}> {{name}} · level {{minLevel}} · {{slot}} slot</label>{{/each}}<h4>Ship talents</h4>{{#each talents}}<label class="alpha-check"><input type="checkbox" value="{{id}}" data-alpha-fit="talents" {{#if checked}}checked{{/if}}> {{name}} · level {{minLevel}}</label>{{/each}}</details>
  <details><summary>Library / combat deck · {{deckCount}} cards selected</summary><p>15 cards minimum. Up to two copies; Unique Burn cards one copy. The five-card opening hand is random.</p><div class="alpha-deck-builder">{{#each deckOptions}}<label>{{name}} · {{ap}} AP<input type="number" min="0" max="{{max}}" value="{{count}}" data-alpha-deck="{{id}}"></label>{{/each}}</div></details>
  {{#if buildError}}<p class="alpha-error">{{buildError}}</p>{{/if}}
  {{#if gm}}<button class="alpha-primary" data-alpha-cmd="start" {{#unless canStart}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>Build test fleet and start</button>{{#if s}}{{#unless complete}}<p>End the active alpha encounter before rebuilding.</p>{{/unless}}{{/if}}{{else}}<p>The GM creates the alpha encounter. Reopen this window when it is ready.</p>{{/if}}
{{/if}}
{{#if showPlan}}
  {{#if planning}}<h3>{{ship.profile.name}} · {{ship.profile.role}}</h3><label>Complete hull maneuver<select data-alpha-maneuver {{#if locked}}disabled{{/if}}>{{#each routes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · {{ap}} AP · {{description}}</option>{{/each}}</select></label>
  {{#if route}}<section class="alpha-route"><div>{{{route.svg}}}</div><div><h3>{{route.name}}</h3><p>{{route.description}}</p><b>{{route.ap}} AP</b><p class="alpha-note">One hex per movement step. Turns happen at the printed waypoints.</p><button data-alpha-cmd="preview">Preview on canvas</button></div></section>{{/if}}
  <div class="alpha-actions"><button data-alpha-cmd="plan" {{#unless canPlan}}disabled{{/unless}} {{#if locked}}disabled{{/if}} {{#if busy}}disabled{{/if}}>Navigator · Stage maneuver</button><button class="alpha-primary" data-alpha-cmd="lock" {{#if locked}}disabled{{/if}} {{#unless canLock}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>{{#if locked}}Maneuver locked{{else}}Lock maneuver{{/if}}</button>{{#if gm}}<button data-alpha-cmd="ready-enemies" {{#if busy}}disabled{{/if}}>Ready enemies · Straight 3</button><button data-alpha-cmd="move" {{#unless canMove}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>Reveal and move together</button>{{/if}}</div>
  <p class="alpha-note">Ships stay still until all plans are locked and the GM reveals movement. Better collision save continues; the loser stops and is pushed aside if needed and safe.</p>{{/if}}
  {{#if cardPhase}}<p>Card phase: <b>{{activeName}}</b>. Open Cards to spend shared AP or Fire Battery.</p>{{/if}}
  {{#if targeting}}<h3>Declare all targets before rolling</h3>{{#each orders}}<label>{{name}}<select data-alpha-order-target="{{id}}" data-ship-id="{{shipId}}" {{#unless allowed}}disabled{{/unless}}><option value="">Choose legal target</option>{{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><button data-alpha-cmd="hold-order" data-attack-id="{{id}}" data-ship-id="{{shipId}}" {{#unless allowed}}disabled{{/unless}}>Hold this shot</button>{{/each}}{{#if gm}}<button class="alpha-primary" data-alpha-cmd="begin-damage" {{#if busy}}disabled{{/if}}>Lock targets · Begin damage phase</button>{{/if}}{{/if}}
  {{#if retargeting}}<h3>The declared target left the firing solution</h3><p>Choose one legal replacement, or hold this shot. AP stays spent; a held shot spends no ammunition or reload.</p>{{#if canRetarget}}{{#each retargets}}<button data-alpha-cmd="retarget" data-target-id="{{id}}" data-ship-id="{{@root.pending.shipId}}">Target {{name}}</button>{{/each}}<button data-alpha-cmd="retarget" data-ship-id="{{pending.shipId}}">Hold shot</button>{{/if}}{{/if}}
  {{#if responding}}<p>{{pending.attacker}} → {{pending.defender}}. Open Cards for the defender's Instant or pass response.</p>{{/if}}
{{/if}}
{{#if showHand}}
  {{#if responding}}<section class="alpha-response"><b>{{pending.attacker}} → {{pending.defender}}</b><p>One Instant may be played before the attack roll. Hull damage is applied at the end of the exchange.</p>{{#if canRespond}}<button data-alpha-cmd="pass-response" {{#if busy}}disabled{{/if}}>Pass response</button>{{/if}}{{#if pending.ready}}{{#if canRollAttack}}<button class="alpha-primary" data-alpha-cmd="attack" data-ship-id="{{pending.shipId}}" {{#if busy}}disabled{{/if}}>Roll attack</button>{{/if}}{{/if}}</section>{{/if}}
  {{#if canMulligan}}<p class="alpha-note">Opening hand: raise up to two cards to return, or keep all five.</p><button data-alpha-cmd="mulligan" {{#if busy}}disabled{{/if}}>Keep / mulligan selected</button>{{/if}}
  <div class="alpha-hand">{{#each hand}}<button type="button" class="alpha-playing-card {{#if selected}}is-selected{{/if}} {{#if burn}}is-burn{{/if}} {{#if delayed}}is-delayed{{/if}} {{#if (eq timing 'instant')}}is-instant{{/if}}" data-alpha-card="{{instanceId}}" aria-pressed="{{selected}}"><span class="alpha-card-band">{{band}} · {{ap}} AP</span><img src="{{art}}" alt=""><strong>{{name}}</strong><small>{{stations}} · {{role}}</small></button>{{/each}}</div>
  {{#if card}}<article class="alpha-card-detail"><h3>{{card.name}} · {{card.ap}} AP</h3><p>{{card.text}}</p><details><summary>Four outcomes</summary><p><b>Critical success:</b> printed critical benefit.</p><p><b>Success:</b> normal printed effect.</p><p><b>Failure:</b> {{card.failure}}</p><p><b>Critical failure:</b> base support effect still works; draw one station Complication instead of a fixed penalty. Attacks/boarding can still fail.</p>{{#if (eq card.role 'Attack')}}<p>The Battle Watch attack is rolled separately in the Damage phase: critical hit doubles complete damage; success hits; failure misses; critical failure misses and uses the complication deck.</p>{{/if}}</details>
  <div class="alpha-form-grid"><label>Station skill<select data-alpha-skill>{{#each skillOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Gunnery skill<select data-alpha-attack-skill>{{#each attackSkillOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label></div>
  <button class="alpha-primary" data-alpha-cmd="play" {{#unless playable}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>Play {{card.name}}</button>{{#each boardingExploits}}<button data-alpha-cmd="play" data-effect-id="{{id}}">Play with boarding opening · +1 AP</button>{{/each}}</article>{{/if}}
  <section class="alpha-weapon-controls"><h3>Weapons and adjustments</h3><label>Battery<select data-alpha-battery>{{#each batteries}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · {{#if ready}}Ready{{else}}Ready R{{readyRound}}{{/if}}</option>{{/each}}</select></label>
  <button data-alpha-cmd="arcs">Show firing arc and range</button><label>Boarding target<select data-alpha-target><option value="">Choose target</option>{{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
  <label>Movement card choice<select data-alpha-adjustment>{{#each adjustments}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
  {{#if canFinish}}<div class="alpha-actions"><button data-alpha-cmd="fire" {{#if busy}}disabled{{/if}}>Fire Battery · 1 AP</button><button data-alpha-cmd="regroup" {{#unless card}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>Regroup selected · 1 AP</button><button class="alpha-primary" data-alpha-cmd="finish-card" {{#if busy}}disabled{{/if}}>Finish Card phase</button></div>{{/if}}</section>
  {{#each exploits}}<button data-alpha-cmd="exploit" data-effect-id="{{id}}" data-ship-id="{{payer}}" {{#if @root.busy}}disabled{{/if}}>Exploit {{name}} · 1 additional AP</button>{{/each}}
{{/if}}
{{#if showShip}}<h3>{{ship.name}} · {{ship.profile.name}} L{{ship.profile.level}}</h3><p>AC {{ship.profile.ac}} · Hull {{ship.profile.maxHull}} · Structure +{{ship.profile.structure}} · Support DC {{ship.profile.dc}} · {{ship.profile.footprint}} occupied hex(es)</p><p>Hold {{ship.profile.cargoBulk}} Bulk · Slots {{ship.profile.fitting}} · Deck {{ship.profile.deck}} · Hand {{ship.profile.hand}}</p><p>Hex {{ship.pose.q}}, {{ship.pose.r}} · Heading {{ship.pose.heading}}</p><h4>Weapons</h4>{{#each weaponDetails}}<p><b>{{name}}</b> · {{formula}} damage · Range {{range}} hex · {{arc}}° arc · Reload {{reload}}</p>{{/each}}<button data-alpha-cmd="find">Find ship token</button>
<details open><summary>Stations and crew</summary>{{#each stations}}<label>{{name}} · {{skills}}<select data-alpha-assign="{{id}}" {{#unless @root.gm}}disabled{{/unless}}><option value="">NPC crew · ship baseline</option>{{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/each}}<p class="alpha-note">PC skill checks use ship level + crew attribute + training. Personal level is not added again.</p></details>
<details><summary>Capabilities across pillars</summary><p>Travel Supply reduction: {{ship.profile.capabilities.travelSupplyReduction}} · Cruise bonus: {{ship.profile.capabilities.travelSpeedBonus}} · Trade bonus: {{ship.profile.capabilities.tradeBonus}}</p><p>Event tags: {{ship.profile.capabilities.eventTags}}</p><small>These alpha capabilities are recorded for testing; legacy travel/events are not automatically rewritten.</small></details>
{{#if boarding}}<section class="alpha-warning"><h4>Boarding lines secured</h4><p>The ship battle can pause for a prepared PF2e deck scene. Use normal Foundry character tokens there, then return to this saved battle.</p>{{#if gm}}{{#if boardingPaused}}<button data-alpha-cmd="return-boarding">Return to ship battle</button>{{else}}<select data-alpha-boarding-scene><option value="">Choose prepared deck scene</option>{{#each boardingScenes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><button data-alpha-cmd="open-boarding">Pause ship battle · Open deck</button>{{/if}}{{/if}}</section>{{/if}}
<h4>Prepared effects</h4>{{#each prepared}}<p>{{kind}} +{{amount}} · Round {{start}}–{{end}}</p>{{/each}}<h4>Complications</h4>{{#each effects}}<p>{{label}} · Expires after R{{expiresRound}}</p>{{/each}}
{{/if}}
{{#if showLog}}<p class="alpha-note">Build: {{buildId}}</p><button data-alpha-cmd="report">Copy alpha diagnostic report</button>{{#if report}}<textarea readonly rows="8" aria-label="Alpha diagnostic report">{{report}}</textarea>{{/if}}{{#if cleanup}}<button class="alpha-primary" data-alpha-cmd="round" {{#unless gm}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>Start next round</button>{{/if}}{{#if complete}}<p class="alpha-warning">Encounter ended. Review results or open Builder for another test.</p>{{/if}}<div class="alpha-log">{{#each history}}<p><small>R{{round}}</small> {{text}}</p>{{/each}}</div>{{/if}}
</main>
<footer class="alpha-footer"><span>{{#if busy}}Resolving…{{else}}Ready{{/if}}</span>{{#if s}}<button data-alpha-cmd="scene">View scene</button>{{/if}}<button data-alpha-cmd="hide-overlay">Clear preview</button><button data-alpha-cmd="minimize">Minimize</button>{{#if gm}}{{#if s}}{{#unless complete}}<button data-alpha-cmd="end" {{#if busy}}disabled{{/if}}>End alpha test</button>{{/unless}}{{/if}}{{/if}}</footer>
</section>
